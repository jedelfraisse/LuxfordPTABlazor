@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.WebUtilities
@using LuxfordPTAWeb.Client.Components
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager


<AuthorizeView>
	<Authorized>
		<div style="margin-right: 10px">Welcome @GetDisplayName(context.User)!</div>
        <div>
            <a href="Account/Manage" class="text-decoration-none"><i class="bi bi-gear"></i> Manage Account</a>
        </div>
        @if (context.User.IsInRole("Admin") || context.User.IsInRole("BoardMember"))
		{
			<div><a href="admin" class="text-decoration-none"><i class="bi bi-shield-lock text-danger"></i> Admin Dashboard</a></div>
		}
        @if (context.User.IsInRole("Admin") || context.User.IsInRole("Trusted"))
        {
            <div>
                <button class="btn btn-link text-decoration-none p-0" @onclick="OpenBugReportModal">
                    <i class="bi bi-bug"></i> Bug Report
                </button>
            </div>
            <BugReportModal IsOpen="isBugReportModalOpen" IsOpenChanged="OnBugReportModalChanged" />
        }
		<div>
			<form action="Account/Logout" method="post" class="d-inline">
				<AntiforgeryToken />
				<input type="hidden" name="ReturnUrl" value="@currentUrl" />
				<button type="submit" class="btn btn-link text-danger p-0 m-0 text-decoration-none">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </button>
			</form>
		</div>
	</Authorized>
	<NotAuthorized>
		<div style="margin-right: 10px">Welcome Guest!</div>
		<a href="Account/Login?returnUrl=@Uri.EscapeDataString(ResolveReturnUrl())" class="btn btn-primary btn-sm">
			<i class="bi bi-person-plus"></i> Login
		</a>
	</NotAuthorized>
</AuthorizeView>

@code {
    private string currentUrl = string.Empty;
    private bool isBugReportModalOpen = false;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.Uri;
    }

    /// <summary>
    /// The URL to send the user back to after logging in. If they're already sitting on the
    /// login flow itself (e.g. followed an admin-only link while signed out, then clicked this
    /// button again), reuse whatever returnUrl that page already carries instead of wrapping the
    /// login page's own URL — otherwise every click nests another layer of ReturnUrl=ReturnUrl=...
    /// </summary>
    private string ResolveReturnUrl()
    {
        var uri = new Uri(currentUrl);
        var path = uri.AbsolutePath.TrimEnd('/');

        if (path.Equals("/Account/Login", StringComparison.OrdinalIgnoreCase) ||
            path.Equals("/Account/LoginVerify", StringComparison.OrdinalIgnoreCase))
        {
            var query = QueryHelpers.ParseQuery(uri.Query);
            var existing = query.TryGetValue("returnUrl", out var v1) ? v1.ToString()
                : query.TryGetValue("ReturnUrl", out var v2) ? v2.ToString()
                : string.Empty;

            return string.IsNullOrWhiteSpace(existing) ? "/" : existing;
        }

        return currentUrl;
    }

    private string GetDisplayName(System.Security.Claims.ClaimsPrincipal user)
    {
        var first = user.FindFirst("given_name")?.Value;
        var last = user.FindFirst("family_name")?.Value;
        if (!string.IsNullOrWhiteSpace(first) && !string.IsNullOrWhiteSpace(last))
            return $"{first} {last}";
        if (!string.IsNullOrWhiteSpace(first))
            return first;
        return user.Identity?.Name ?? "User";
    }

    private void OpenBugReportModal()
    {
        isBugReportModalOpen = true;
    }

    private void OnBugReportModalChanged(bool value)
    {
        isBugReportModalOpen = value;
    }
}
