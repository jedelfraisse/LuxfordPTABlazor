@page "/admin/eventcontrols/{controlName}/{eventId:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,BoardMember")]
@using LuxfordPTAWeb.Client.Components.TalentShow
@using LuxfordPTAWeb.Shared.DTOs
@using LuxfordPTAWeb.Shared.Models
@inject HttpClient Http

<PageTitle>@(eventItem?.Title ?? "Event Director")</PageTitle>

@if (isLoading)
{
    <div class="alert alert-info"><em>Loading workspace...</em></div>
}
else if (eventItem == null)
{
    <div class="alert alert-warning"><em>Event not found.</em></div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="mb-0">@GetTitle()</h1>
            <div class="text-muted">@GetSubtitle()</div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" href="@($"/admin/events/edit/{eventItem.Id}?tab=controls")">Back to Event Helpers</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="card">
        <div class="card-body">
            @if (normalizedControlName == "talent-show")
            {
                <h5 class="mb-3">@talentShowCurrentStage Stage</h5>
                @switch (talentShowCurrentStage)
                {
                    case TalentShowLifecycleState.Planning:
                        <PlanningStagePanel EventId="@eventItem.Id" />
                        break;
                    case TalentShowLifecycleState.TryOuts:
                        <TryOutsStagePanel EventId="@eventItem.Id" />
                        break;
                    case TalentShowLifecycleState.Rehearsal:
                        <RehearsalStagePanel EventId="@eventItem.Id" />
                        break;
                    case TalentShowLifecycleState.PreShow:
                        <PreShowStagePanel EventId="@eventItem.Id" />
                        break;
                    case TalentShowLifecycleState.HostTalk:
                        <HostTalkStagePanel EventId="@eventItem.Id" />
                        break;
                    case TalentShowLifecycleState.ActShow:
                        <ActShowStagePanel EventId="@eventItem.Id" />
                        break;
                    case TalentShowLifecycleState.Intermission:
                        <IntermissionStagePanel EventId="@eventItem.Id" />
                        break;
                    case TalentShowLifecycleState.PostShow:
                        <PostShowStagePanel EventId="@eventItem.Id" />
                        break;
                }

                <div class="mt-3">
                    <a class="btn btn-outline-secondary btn-sm" href="@($"/admin/eventcontrols/talent-show-stages/{eventItem.Id}")">
                        Open All Stage Panels
                    </a>
                </div>
            }
            else if (normalizedControlName == "bingo")
            {
                <p>Bingo director workspace is coming next.</p>
            }
            else if (normalizedControlName == "election")
            {
                <p>Election director workspace is coming next.</p>
            }
            else
            {
                <p>No workspace is defined for this helper yet.</p>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string ControlName { get; set; } = string.Empty;
    [Parameter] public int EventId { get; set; }

    private Event? eventItem;
    private bool isLoading = true;
    private string normalizedControlName = string.Empty;
    private string talentShowCurrentStage = TalentShowLifecycleState.PreShow;
    private string errorMessage = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        normalizedControlName = (ControlName ?? string.Empty).Trim().ToLowerInvariant();

        try
        {
            eventItem = await Http.GetFromJsonAsync<Event>($"api/events/{EventId}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            eventItem = null;
            isLoading = false;
            return;
        }

        if (eventItem == null)
        {
            isLoading = false;
            return;
        }

        if (normalizedControlName == "talent-show")
        {
            try
            {
                var state = await Http.GetFromJsonAsync<TalentShowRealtimeState>($"api/talentshow/{EventId}/state");
                talentShowCurrentStage = NormalizeTalentShowStage(state?.CurrentState);
            }
            catch (Exception ex)
            {
                errorMessage = $"Unable to load current talent show stage: {ex.Message}";
            }
        }

        isLoading = false;
    }

    private string GetTitle()
    {
        return normalizedControlName switch
        {
            "talent-show" => $"{eventItem?.Title} Talent Show Director",
            "bingo" => $"{eventItem?.Title} Bingo Director",
            "election" => $"{eventItem?.Title} Election Director",
            _ => $"{eventItem?.Title} Event Helper"
        };
    }

    private string GetSubtitle()
    {
        return normalizedControlName switch
        {
            "talent-show" => $"Current stage: {talentShowCurrentStage}",
            "bingo" => "Generic event workspace",
            "election" => "Generic event workspace",
            _ => "Generic event workspace"
        };
    }

    private static string NormalizeTalentShowStage(string? currentState)
    {
        if (string.IsNullOrWhiteSpace(currentState))
        {
            return TalentShowLifecycleState.PreShow;
        }

        var matchedState = TalentShowLifecycleState.All
            .FirstOrDefault(s => s.Equals(currentState, StringComparison.OrdinalIgnoreCase));

        if (string.IsNullOrWhiteSpace(matchedState))
        {
            return TalentShowLifecycleState.PreShow;
        }

        return matchedState;
    }
}
