@page "/admin/database-backup"
@using LuxfordPTAWeb.Client.Components.Admin
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject HttpClient Http

<PageTitle>Database Backup</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
	<h1><i class="bi bi-database"></i> Database Backup</h1>
	<a href="/admin" class="btn btn-outline-secondary">
		<i class="bi bi-arrow-left"></i> Back to Dashboard
	</a>
</div>

<div class="alert alert-warning">
	<i class="bi bi-exclamation-triangle"></i> 
	<strong>Important:</strong> Database backups should be performed regularly. Contact your system administrator 
	for automated backup schedules and disaster recovery plans.
</div>

<DatabaseBackupWidget />

<div class="card shadow-sm mt-4">
	<div class="card-header bg-light">
		<h5 class="mb-0"><i class="bi bi-info-circle"></i> Backup Best Practices</h5>
	</div>
	<div class="card-body">
		<h6>Recommendations:</h6>
		<ul>
			<li><strong>Frequency:</strong> Perform backups daily, especially before major changes</li>
			<li><strong>Storage:</strong> Store backups in multiple locations (local + cloud)</li>
			<li><strong>Testing:</strong> Regularly test backup restoration procedures</li>
			<li><strong>Retention:</strong> Keep backups for at least 30 days</li>
			<li><strong>Security:</strong> Encrypt sensitive backup files</li>
		</ul>
		
		<h6 class="mt-3">Before Major Changes:</h6>
		<ul>
			<li>Always create a backup before applying database migrations</li>
			<li>Backup before bulk data imports or deletions</li>
			<li>Create snapshots before software updates</li>
		</ul>
	</div>
</div>
