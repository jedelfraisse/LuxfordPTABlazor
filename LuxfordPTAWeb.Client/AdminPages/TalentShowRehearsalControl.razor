@page "/admin/talent-show/rehearsal"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,BoardMember")]
@using LuxfordPTAWeb.Shared.DTOs
@using Microsoft.AspNetCore.SignalR.Client
@inject HttpClient Http
@inject NavigationManager Navigation
@implements IAsyncDisposable

@if (!Embedded)
{
    <PageTitle>@(PageTitleText)</PageTitle>
}

@if (!Embedded)
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-broadcast"></i> @PageTitleText</h1>
        <a href="@EffectiveBackUrl" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert alert-info">@statusMessage</div>
}

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            @if (!IsEventScoped)
            {
                <div class="col-md-4">
                    <label class="form-label">Show Template</label>
                    <InputSelect class="form-select" @bind-Value="selectedShowKey">
                        @foreach (var key in availableShowKeys)
                        {
                            <option value="@key">@key</option>
                        }
                    </InputSelect>
                </div>
            }
            <div class="col-md-2">
                <button class="btn btn-primary w-100" @onclick="LoadShowAsync" disabled="@isBusy">
                    Load
                </button>
            </div>
            <div class="col-md-3">
                <label class="form-label">Session Code</label>
                <InputText class="form-control" @bind-Value="state.SessionCode" />
            </div>
            <div class="col-md-3">
                <a class="btn btn-outline-success w-100" href="/display" target="_blank" rel="noopener noreferrer">
                    Open Display
                </a>
            </div>
        </div>
    </div>
</div>

@if (hasLoadedState)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex gap-2 flex-wrap align-items-center">
                <button class="btn btn-outline-secondary" @onclick="MovePrevious" disabled="@(state.CurrentIndex <= 0 || isBusy)">Previous Act</button>
                <button class="btn btn-outline-primary" @onclick="MoveNext" disabled="@(state.CurrentIndex >= state.Items.Count - 1 || isBusy)">Next Act</button>
                <button class="btn btn-success" @onclick="PublishStateAsync" disabled="@(!isConnected || isBusy)">Push Update</button>
                <button class="btn btn-outline-danger" @onclick="ClearSessionAsync" disabled="@(!isConnected || isBusy)">Clear Session</button>
            </div>
            <div class="row g-2 mt-3">
                <div class="col-12">
                    <label class="form-label mb-2"><strong>Lifecycle Stage</strong></label>
                    <div class="d-flex gap-2 align-items-center flex-wrap" style="margin-bottom: 1rem;">
                        @for (int i = 0; i < TalentShowLifecycleState.All.Length; i++)
                        {
                            var stateVal = TalentShowLifecycleState.All[i];
                            var isActive = state.CurrentState == stateVal;
                            var stateNum = i + 1;
                            <button 
                                class="btn @(isActive ? "btn-success" : "btn-outline-secondary") btn-sm"
                                style="min-width: 70px; font-weight: @(isActive ? "bold" : "normal")"
                                @onclick="() => TransitionToStateAsync(stateVal)"
                                disabled="@isBusy">
                                @stateNum. @stateVal
                            </button>
                        }
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label mb-1">Live Sub-State</label>
                    <InputSelect class="form-select form-select-sm" @bind-Value="state.LiveSubState" disabled="@(state.CurrentState is not TalentShowLifecycleState.HostTalk and not TalentShowLifecycleState.ActShow and not TalentShowLifecycleState.Intermission)">
                        @foreach (var sub in TalentShowLiveSubState.All)
                        {
                            <option value="@sub">@sub</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-3">
                    <label class="form-label mb-1">Next Sub-State</label>
                    <InputSelect class="form-select form-select-sm" @bind-Value="state.NextLiveSubState" disabled="@(state.CurrentState is not TalentShowLifecycleState.HostTalk and not TalentShowLifecycleState.ActShow and not TalentShowLifecycleState.Intermission)">
                        @foreach (var sub in TalentShowLiveSubState.All)
                        {
                            <option value="@sub">@sub</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-2">
                    <label class="form-label mb-1">Est. Minutes</label>
                    <InputNumber class="form-control form-control-sm" @bind-Value="state.EstimatedSegmentMinutes" />
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button class="btn btn-outline-secondary btn-sm w-100" @onclick="MarkSegmentStartedNow">Now</button>
                </div>
            </div>
            <div class="mt-2">
                <strong>Connection:</strong> @(isConnected ? "Connected" : "Disconnected")
                <span class="ms-3"><strong>Updated:</strong> @state.UpdatedAtUtc.ToLocalTime().ToString("g")</span>
                <span class="ms-3"><strong>Segment Start:</strong> @state.SegmentStartedAtUtc.ToLocalTime().ToString("t")</span>
            </div>
        </div>
    </div>

    var current = GetCurrentItem();
    <div class="card mb-3">
        <div class="card-header">
            <h5 class="mb-0">Current Presentation</h5>
        </div>
        <div class="card-body">
            @if (current == null)
            {
                <em>Select an act to begin.</em>
            }
            else
            {
                <h4>@current.Order. @current.ActTitle</h4>
                <p class="mb-1"><strong>Performer:</strong> @current.PerformerName</p>
                <p class="mb-1"><strong>Category:</strong> @current.Category</p>
                <p class="mb-0"><strong>Intro:</strong> @current.IntroLine</p>
                <p class="mb-0 mt-1"><strong>State:</strong> @state.OverallState @(state.OverallState == TalentShowOverallState.Live ? $" / {state.LiveSubState}" : string.Empty)</p>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h5 class="mb-0">Voting Summary (Current Act)</h5>
        </div>
        <div class="card-body">
            @if (current == null)
            {
                <em>Select an act to view votes.</em>
            }
            else
            {
                var summary = GetVoteSummary(current.Order);
                <div class="row">
                    <div class="col-md-3"><strong>Judge Votes:</strong> @summary.JudgeCount</div>
                    <div class="col-md-3"><strong>Audience Votes:</strong> @summary.AudienceCount</div>
                    <div class="col-md-3"><strong>Judge Avg Total:</strong> @summary.JudgeAverageTotal.ToString("0.0")</div>
                    <div class="col-md-3"><strong>Audience Avg Total:</strong> @summary.AudienceAverageTotal.ToString("0.0")</div>
                </div>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Schedule</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Act</th>
                            <th>Performer</th>
                            <th>Duration</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in state.Items.OrderBy(i => i.Order))
                        {
                            var idx = state.Items.FindIndex(i => i.Order == item.Order && i.ActTitle == item.ActTitle && i.PerformerName == item.PerformerName);
                            <tr class="@(idx == state.CurrentIndex ? "table-primary" : string.Empty)">
                                <td>@item.Order</td>
                                <td>@item.ActTitle</td>
                                <td>@item.PerformerName</td>
                                <td>@item.DurationMinutes min</td>
                                <td>
                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => SetCurrentIndex(idx)">Go Live</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h5 class="mb-0">Connected Devices / Displays</h5>
        </div>
        <div class="card-body">
            @if (!connectedDevices.Any())
            {
                <em>No displays connected yet. Open <strong>/display</strong> on a device to generate a pairing code.</em>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Pairing Code</th>
                                <th>Device</th>
                                <th>Assigned Session</th>
                                <th>Assigned Display</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var device in connectedDevices.OrderBy(d => d.DisplayName))
                            {
                                <tr>
                                    <td><strong>@device.PairingCode</strong></td>
                                    <td style="min-width: 250px;">
                                        <div class="input-group input-group-sm">
                                            <input class="form-control"
                                                   value="@GetEditableDisplayName(device.PairingCode, device.DisplayName)"
                                                   @oninput="(e) => SetEditableDisplayName(device.PairingCode, e.Value?.ToString())" />
                                            <button class="btn btn-outline-secondary"
                                                    @onclick="() => UpdateDeviceNameAsync(device.PairingCode)"
                                                    disabled="@(!isConnected)">
                                                Rename
                                            </button>
                                        </div>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(device.AssignedSessionCode) ? "Unassigned" : device.AssignedSessionCode)</td>
                                    <td>@(string.IsNullOrWhiteSpace(device.AssignedDisplayRole) ? "Unassigned" : device.AssignedDisplayRole)</td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <select class="form-select form-select-sm" style="max-width: 190px;" value="@GetSelectedRole(device.PairingCode)" @onchange="(e) => SetSelectedRole(device.PairingCode, e.Value?.ToString())">
                                                @foreach (var role in TalentShowDisplayRole.All)
                                                {
                                                    <option value="@role">@role</option>
                                                }
                                            </select>
                                            <button class="btn btn-outline-primary btn-sm" @onclick="() => AssignDeviceAsync(device.PairingCode)" disabled="@(!isConnected || string.IsNullOrWhiteSpace(state.SessionCode))">
                                                Assign
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => UnassignDeviceAsync(device.PairingCode)" disabled="@(!isConnected)">
                                                Clear
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public int? EventId { get; set; }
    [Parameter] public string? TitleText { get; set; }
    [Parameter] public string? BackUrl { get; set; }
    [Parameter] public string? PreferredShowKey { get; set; }
    [Parameter] public string? SessionCodeOverride { get; set; }

    private HubConnection? hubConnection;
    private List<string> availableShowKeys = new();
    private string selectedShowKey = "luxford-got-talent";
    private TalentShowRehearsalPackage? rehearsalPackage;
    private TalentShowRealtimeState state = new();
    private List<TalentShowConnectedDevice> connectedDevices = new();
    private readonly Dictionary<string, string> deviceRoleSelections = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> deviceNameEdits = new(StringComparer.OrdinalIgnoreCase);
    private bool isConnected;
    private bool isBusy;
    private string errorMessage = string.Empty;
    private string statusMessage = string.Empty;
    private bool hasLoadedState;
    private bool IsEventScoped => EventId.HasValue && EventId.Value > 0;
    private string PageTitleText => string.IsNullOrWhiteSpace(TitleText) ? "Talent Show Rehearsal Control" : TitleText;
    private string EffectiveBackUrl => string.IsNullOrWhiteSpace(BackUrl) ? "/admin/events" : BackUrl;

    protected override async Task OnInitializedAsync()
    {
        if (!IsEventScoped)
        {
            await LoadShowKeysAsync();
        }
        await EnsureHubConnectionAsync();
        await LoadShowAsync();
    }

    private async Task LoadShowKeysAsync()
    {
        try
        {
            availableShowKeys = await Http.GetFromJsonAsync<List<string>>("api/talentshow-test/shows") ?? new();
            var preferredShowKey = PreferredShowKey?.Trim();
            if (!string.IsNullOrWhiteSpace(preferredShowKey) &&
                availableShowKeys.Contains(preferredShowKey, StringComparer.OrdinalIgnoreCase))
            {
                selectedShowKey = availableShowKeys.First(key => key.Equals(preferredShowKey, StringComparison.OrdinalIgnoreCase));
            }

            if (!availableShowKeys.Any())
            {
                availableShowKeys.Add(selectedShowKey);
            }
            else if (!availableShowKeys.Contains(selectedShowKey, StringComparer.OrdinalIgnoreCase))
            {
                selectedShowKey = availableShowKeys.First();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load rehearsal files: {ex.Message}";
        }
    }

    private async Task LoadShowAsync()
    {
        errorMessage = string.Empty;
        statusMessage = string.Empty;
        isBusy = true;

        try
        {
            if (IsEventScoped)
            {
                state = await Http.GetFromJsonAsync<TalentShowRealtimeState>($"api/talentshow/{EventId}/state") ?? new TalentShowRealtimeState();
                if (!string.IsNullOrWhiteSpace(SessionCodeOverride))
                {
                    state.SessionCode = SessionCodeOverride.Trim();
                }

                hasLoadedState = true;
                statusMessage = "Loaded event-scoped Talent Show state.";
                await JoinSessionAsync();
                await PublishStateAsync();
                return;
            }

            rehearsalPackage = await Http.GetFromJsonAsync<TalentShowRehearsalPackage>($"api/talentshow-test/shows/{selectedShowKey}");
            if (rehearsalPackage == null)
            {
                errorMessage = "Selected rehearsal package was empty.";
                return;
            }

            state = new TalentShowRealtimeState
            {
                ShowName = rehearsalPackage.ShowName,
                SessionCode = string.IsNullOrWhiteSpace(SessionCodeOverride) ? rehearsalPackage.SessionCode : SessionCodeOverride.Trim(),
                IsLiveMode = false,
                OverallState = TalentShowOverallState.PreShow,
                LiveSubState = TalentShowLiveSubState.HostTalk,
                NextLiveSubState = TalentShowLiveSubState.ActShow,
                SegmentStartedAtUtc = DateTime.UtcNow,
                EstimatedSegmentMinutes = 5,
                CurrentIndex = rehearsalPackage.Items.Any() ? 0 : -1,
                Items = rehearsalPackage.Items.OrderBy(i => i.Order).ToList(),
                Presentation = rehearsalPackage.Presentation,
                UpdatedAtUtc = DateTime.UtcNow
            };

            hasLoadedState = true;
            statusMessage = $"Loaded {rehearsalPackage.ShowName}.";
            await JoinSessionAsync();
            await PublishStateAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load selected rehearsal package: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task EnsureHubConnectionAsync()
    {
        if (hubConnection != null)
        {
            return;
        }

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/talent-show"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<TalentShowRealtimeState>("ShowStateUpdated", incomingState =>
        {
            state = incomingState;
            statusMessage = $"State synced at {incomingState.UpdatedAtUtc.ToLocalTime():T}.";
            InvokeAsync(StateHasChanged);
        });

        hubConnection.On<List<TalentShowConnectedDevice>>("DeviceRegistryUpdated", incomingDevices =>
        {
            connectedDevices = incomingDevices;
            EnsureRoleSelections();
            EnsureNameSelections();
            InvokeAsync(StateHasChanged);
        });

        hubConnection.On("SessionCleared", () =>
        {
            statusMessage = "Session was cleared.";
            state.CurrentIndex = -1;
            InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
        await hubConnection.InvokeAsync("SubscribeController");
        connectedDevices = await hubConnection.InvokeAsync<List<TalentShowConnectedDevice>>("GetDeviceRegistry");
        EnsureRoleSelections();
        EnsureNameSelections();
        isConnected = true;
    }

    private async Task JoinSessionAsync()
    {
        if (hubConnection == null || string.IsNullOrWhiteSpace(state.SessionCode))
        {
            return;
        }

        await hubConnection.InvokeAsync("JoinSession", state.SessionCode);
        isConnected = hubConnection.State == HubConnectionState.Connected;
    }

    private TalentShowScheduleItem? GetCurrentItem()
    {
        if (state.CurrentIndex < 0 || state.CurrentIndex >= state.Items.Count)
        {
            return null;
        }

        return state.Items[state.CurrentIndex];
    }

    private async Task PublishStateAsync()
    {
        if (hubConnection == null || string.IsNullOrWhiteSpace(state.SessionCode))
        {
            return;
        }

        ApplyLegacyStateFromCurrentState();
        state.IsLiveMode = state.OverallState == TalentShowOverallState.Live;
        if (state.OverallState != TalentShowOverallState.Live)
        {
            state.LiveSubState = TalentShowLiveSubState.HostTalk;
        }

        if (IsEventScoped)
        {
            await Http.PostAsJsonAsync($"api/talentshow/{EventId}/state", state);
        }

        state.UpdatedAtUtc = DateTime.UtcNow;
        await hubConnection.InvokeAsync("PublishState", state);
        statusMessage = "Update pushed to displays.";
    }

    private async Task ClearSessionAsync()
    {
        if (hubConnection == null || string.IsNullOrWhiteSpace(state.SessionCode))
        {
            return;
        }

        if (IsEventScoped)
        {
            state.CurrentIndex = state.Items.Any() ? 0 : -1;
            state.CurrentState = TalentShowLifecycleState.PreShow;
            state.OverallState = TalentShowOverallState.PreShow;
            state.LiveSubState = TalentShowLiveSubState.HostTalk;
            state.NextLiveSubState = TalentShowLiveSubState.ActShow;
            state.Votes.Clear();
            await Http.PostAsJsonAsync($"api/talentshow/{EventId}/state", state);
        }

        await hubConnection.InvokeAsync("ClearSession", state.SessionCode);
    }

    private void MovePrevious()
    {
        if (state.CurrentIndex > 0)
        {
            state.CurrentIndex--;
            UpdateEstimatedMinutesForCurrentState();
        }
    }

    private void MoveNext()
    {
        if (state.CurrentIndex < state.Items.Count - 1)
        {
            state.CurrentIndex++;
            UpdateEstimatedMinutesForCurrentState();
        }
    }

    private async Task TransitionToStateAsync(string targetState)
    {
        if (!IsEventScoped)
        {
            state.CurrentState = targetState;
            ApplyLegacyStateFromCurrentState();
            await PublishStateAsync();
            return;
        }

        isBusy = true;
        errorMessage = string.Empty;
        try
        {
            var dto = new TalentShowLifecycleTransitionDTO { TargetState = targetState };
            var response = await Http.PostAsJsonAsync($"api/talentshow/{EventId}/transition-lifecycle", dto);
            
            if (response.IsSuccessStatusCode)
            {
                var updatedState = await response.Content.ReadFromJsonAsync<TalentShowRealtimeState>();
                if (updatedState != null)
                {
                    state = updatedState;
                    statusMessage = $"Transitioned to {targetState}.";
                    await PublishStateAsync();
                }
            }
            else
            {
                errorMessage = $"Failed to transition state: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error transitioning state: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private void SetCurrentIndex(int index)
    {
        if (index >= 0 && index < state.Items.Count)
        {
            state.CurrentIndex = index;
            UpdateEstimatedMinutesForCurrentState();
        }
    }

    private void MarkSegmentStartedNow()
    {
        state.SegmentStartedAtUtc = DateTime.UtcNow;
    }

    private void ApplyLegacyStateFromCurrentState()
    {
        state.CurrentState = NormalizeCurrentState(state.CurrentState);

        state.OverallState = state.CurrentState switch
        {
            TalentShowLifecycleState.PostShow => TalentShowOverallState.PostShow,
            TalentShowLifecycleState.HostTalk or TalentShowLifecycleState.ActShow or TalentShowLifecycleState.Intermission => TalentShowOverallState.Live,
            _ => TalentShowOverallState.PreShow
        };

        state.LiveSubState = state.CurrentState switch
        {
            TalentShowLifecycleState.HostTalk => TalentShowLiveSubState.HostTalk,
            TalentShowLifecycleState.Intermission => TalentShowLiveSubState.PauseIntermission,
            _ => TalentShowLiveSubState.ActShow
        };

        state.NextLiveSubState = state.LiveSubState == TalentShowLiveSubState.HostTalk
            ? TalentShowLiveSubState.ActShow
            : TalentShowLiveSubState.HostTalk;
    }

    private static string NormalizeCurrentState(string? currentState)
    {
        if (!string.IsNullOrWhiteSpace(currentState) &&
            TalentShowLifecycleState.All.Contains(currentState, StringComparer.OrdinalIgnoreCase))
        {
            return TalentShowLifecycleState.All.First(state => state.Equals(currentState, StringComparison.OrdinalIgnoreCase));
        }

        return TalentShowLifecycleState.PreShow;
    }

    private void UpdateEstimatedMinutesForCurrentState()
    {
        if (state.OverallState == TalentShowOverallState.Live &&
            state.LiveSubState == TalentShowLiveSubState.ActShow &&
            GetCurrentItem() is { } current)
        {
            state.EstimatedSegmentMinutes = current.DurationMinutes;
        }
    }

    private VoteSummary GetVoteSummary(int actOrder)
    {
        var actVotes = state.Votes.Where(v => v.ActOrder == actOrder).ToList();
        var judgeVotes = actVotes.Where(v => v.IsJudge).ToList();
        var audienceVotes = actVotes.Where(v => !v.IsJudge).ToList();

        return new VoteSummary
        {
            JudgeCount = judgeVotes.Count,
            AudienceCount = audienceVotes.Count,
            JudgeAverageTotal = judgeVotes.Any() ? judgeVotes.Average(v => v.TotalScore) : 0,
            AudienceAverageTotal = audienceVotes.Any() ? audienceVotes.Average(v => v.TotalScore) : 0
        };
    }

    private sealed class VoteSummary
    {
        public int JudgeCount { get; init; }
        public int AudienceCount { get; init; }
        public double JudgeAverageTotal { get; init; }
        public double AudienceAverageTotal { get; init; }
    }

    private string GetSelectedRole(string pairingCode)
    {
        return deviceRoleSelections.TryGetValue(pairingCode, out var role)
            ? role
            : TalentShowDisplayRole.MainBoard;
    }

    private void SetSelectedRole(string pairingCode, string? role)
    {
        if (string.IsNullOrWhiteSpace(pairingCode))
        {
            return;
        }

        var normalized = TalentShowDisplayRole.All
            .FirstOrDefault(r => r.Equals(role, StringComparison.OrdinalIgnoreCase))
            ?? TalentShowDisplayRole.MainBoard;
        deviceRoleSelections[pairingCode] = normalized;
    }

    private async Task AssignDeviceAsync(string pairingCode)
    {
        if (hubConnection == null || string.IsNullOrWhiteSpace(state.SessionCode))
        {
            return;
        }

        await hubConnection.InvokeAsync("AssignDeviceToSession", pairingCode, state.SessionCode, GetSelectedRole(pairingCode));
        statusMessage = $"Assigned {pairingCode} to {state.SessionCode} as {GetSelectedRole(pairingCode)}.";
    }

    private async Task UnassignDeviceAsync(string pairingCode)
    {
        if (hubConnection == null)
        {
            return;
        }

        await hubConnection.InvokeAsync("RemoveDeviceAssignment", pairingCode);
        statusMessage = $"Cleared assignment for {pairingCode}.";
    }

    private string GetEditableDisplayName(string pairingCode, string fallbackName)
    {
        if (deviceNameEdits.TryGetValue(pairingCode, out var edit) && !string.IsNullOrWhiteSpace(edit))
        {
            return edit;
        }

        return fallbackName;
    }

    private void SetEditableDisplayName(string pairingCode, string? name)
    {
        if (string.IsNullOrWhiteSpace(pairingCode))
        {
            return;
        }

        deviceNameEdits[pairingCode] = string.IsNullOrWhiteSpace(name) ? string.Empty : name.Trim();
    }

    private async Task UpdateDeviceNameAsync(string pairingCode)
    {
        if (hubConnection == null)
        {
            return;
        }

        var selectedDevice = connectedDevices.FirstOrDefault(d =>
            d.PairingCode.Equals(pairingCode, StringComparison.OrdinalIgnoreCase));
        var requestedName = GetEditableDisplayName(pairingCode, selectedDevice?.DisplayName ?? string.Empty);
        await hubConnection.InvokeAsync("UpdateDeviceDisplayName", pairingCode, requestedName);
        statusMessage = $"Renamed {pairingCode} to {requestedName}.";
    }

    private void EnsureRoleSelections()
    {
        foreach (var device in connectedDevices)
        {
            if (!deviceRoleSelections.ContainsKey(device.PairingCode))
            {
                deviceRoleSelections[device.PairingCode] = string.IsNullOrWhiteSpace(device.AssignedDisplayRole)
                    ? TalentShowDisplayRole.MainBoard
                    : device.AssignedDisplayRole;
            }
        }
    }

    private void EnsureNameSelections()
    {
        foreach (var device in connectedDevices)
        {
            if (!deviceNameEdits.TryGetValue(device.PairingCode, out var existing) || string.IsNullOrWhiteSpace(existing))
            {
                deviceNameEdits[device.PairingCode] = device.DisplayName;
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
