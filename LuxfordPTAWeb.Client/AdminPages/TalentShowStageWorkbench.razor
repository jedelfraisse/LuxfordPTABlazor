@page "/admin/eventcontrols/talent-show-stages/{eventId:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,BoardMember")]
@using LuxfordPTAWeb.Shared.DTOs
@using LuxfordPTAWeb.Shared.Models
@using LuxfordPTAWeb.Client.Components.TalentShow
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Talent Show Stages - @(eventItem?.Title ?? "Event")</PageTitle>

@if (isLoading)
{
    <div class="alert alert-info"><em>Loading event and stage data...</em></div>
}
else if (eventItem == null)
{
    <div class="alert alert-warning"><em>Event not found.</em></div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-0">@eventItem.Title — Talent Show Stages</h1>
            <div class="text-muted">Configure show details for each stage</div>
        </div>
        <a href="@($"/admin/events/edit/{eventItem.Id}?tab=controls")" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert alert-info">@statusMessage</div>
    }

    <div class="row">
        <div class="col-md-3">
            <div class="list-group sticky-top" style="top: 1rem;">
                @foreach (var stageVal in TalentShowLifecycleState.All)
                {
                    var isActive = currentStage == stageVal;
                    var stageIndex = System.Array.IndexOf(TalentShowLifecycleState.All, stageVal);
                    <button class="list-group-item list-group-item-action @(isActive ? "active" : "")"
                            @onclick="() => SelectStage(stageVal)">
                        <span class="badge bg-secondary me-2">@(stageIndex + 1)</span>
                        @stageVal
                    </button>
                }
            </div>
        </div>

        <div class="col-md-9">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">@currentStage Configuration</h5>
                </div>
                <div class="card-body">
                    @switch (currentStage)
                    {
                        case TalentShowLifecycleState.Planning:
                            <PlanningStagePanel EventId="@eventItem.Id" />
                            break;

                        case TalentShowLifecycleState.TryOuts:
                            <TryOutsStagePanel EventId="@eventItem.Id" />
                            break;

                        case TalentShowLifecycleState.Rehearsal:
                            <RehearsalStagePanel EventId="@eventItem.Id" />
                            break;

                        case TalentShowLifecycleState.PreShow:
                            <PreShowStagePanel EventId="@eventItem.Id" />
                            break;

                        case TalentShowLifecycleState.HostTalk:
                            <HostTalkStagePanel EventId="@eventItem.Id" />
                            break;

                        case TalentShowLifecycleState.ActShow:
                            <ActShowStagePanel EventId="@eventItem.Id" />
                            break;

                        case TalentShowLifecycleState.Intermission:
                            <IntermissionStagePanel EventId="@eventItem.Id" />
                            break;

                        case TalentShowLifecycleState.PostShow:
                            <PostShowStagePanel EventId="@eventItem.Id" />
                            break;
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int eventId { get; set; }

    private Event? eventItem;
    private string currentStage = TalentShowLifecycleState.Planning;
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private string statusMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadEventAsync();
    }

    private async Task LoadEventAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            eventItem = await Http.GetFromJsonAsync<Event>($"/api/events/{eventId}");
            if (eventItem == null)
            {
                errorMessage = "Event not found.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading event: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectStage(string stage)
    {
        currentStage = stage;
        errorMessage = string.Empty;
        statusMessage = string.Empty;
    }
}
