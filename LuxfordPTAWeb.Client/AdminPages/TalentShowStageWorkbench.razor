@page "/admin/eventcontrols/talent-show-director/{eventId:int}"
@page "/admin/eventcontrols/talent-show-stages/{eventId:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,BoardMember")]
@using LuxfordPTAWeb.Shared.Models
@inject HttpClient Http

<PageTitle>Talent Show Director - @(eventItem?.Title ?? "Event")</PageTitle>

@if (isLoading)
{
    <div class="alert alert-info"><em>Loading director hub...</em></div>
}
else if (eventItem == null)
{
    <div class="alert alert-warning"><em>Event not found.</em></div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-0">@eventItem.Title — Talent Show Director Hub</h1>
            <div class="text-muted">Navigate each module in the talent show lifecycle.</div>
        </div>
        <a href="@($"/admin/events/edit/{eventItem.Id}?tab=controls")" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="row">
        @foreach (var hub in sections)
        {
            <div class="col-lg-6 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title mb-1">@hub.Title</h5>
                        <p class="text-muted mb-3">@hub.Description</p>
                        <div class="d-flex gap-2 flex-wrap">
                            @foreach (var action in GetActions(hub))
                            {
                                <a class="@action.ButtonClass" href="@action.Href">@action.Label</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int eventId { get; set; }

    private Event? eventItem;
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private readonly HubSection[] sections =
    [
        new("Global Setup", "Configure defaults and global rules shared across modules.", "global-setup", true),
        new("Sign-Ups", "Configure intake and review submissions.", "signups", true),
        new("Try-Outs", "Configure try-out sessions and run queue decisions.", "tryouts", false),
        new("Rehearsals", "Prepare segment order, timing, media, and cues.", "rehearsals", false),
        new("The Show", "Run the finalized timeline during the live event.", "show", true)
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadEventAsync();
    }

    private async Task LoadEventAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            eventItem = await Http.GetFromJsonAsync<Event>($"/api/events/{eventId}");
            if (eventItem == null)
            {
                errorMessage = "Event not found.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading event: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<HubAction> GetActions(HubSection hub)
    {
        var basePath = $"/admin/eventcontrols/talent-show-director/{eventItem!.Id}";

        if (hub.IsTool)
        {
            if (hub.RouteKey == "global-setup")
            {
                yield return new HubAction("Configure", $"{basePath}/tools/{hub.RouteKey}/configure", "btn btn-outline-primary btn-sm");
                yield break;
            }

            if (hub.RouteKey == "signups")
            {
                yield return new HubAction("Configure", $"{basePath}/tools/signups/configure", "btn btn-outline-primary btn-sm");
                yield return new HubAction("Review", $"{basePath}/tools/signups/review", "btn btn-outline-secondary btn-sm");
                yield return new HubAction("Preview", $"/talent-show/signups/{eventItem!.Id}", "btn btn-outline-dark btn-sm");
            }

            if (hub.RouteKey == "show")
            {
                yield return new HubAction("Configure", $"{basePath}/tools/show/configure", "btn btn-outline-primary btn-sm");
                yield return new HubAction("Live", $"{basePath}/tools/show/live", "btn btn-outline-secondary btn-sm");
                yield return new HubAction("Public", GetPublicEventHref(), "btn btn-outline-dark btn-sm");
            }

            yield break;
        }

        yield return new HubAction("Configure", $"{basePath}/subevents/{hub.RouteKey}/configure", "btn btn-outline-primary btn-sm");

        yield return new HubAction("Sessions", $"{basePath}/subevents/{hub.RouteKey}/sessions", "btn btn-outline-secondary btn-sm");
    }

    private string GetPublicEventHref()
    {
        if (eventItem == null || string.IsNullOrWhiteSpace(eventItem.Slug))
        {
            return "/events";
        }

        return $"/events/{Uri.EscapeDataString(eventItem.Slug)}";
    }

    private sealed record HubSection(string Title, string Description, string RouteKey, bool IsTool);
    private sealed record HubAction(string Label, string Href, string ButtonClass);
}
