@page "/admin/sponsors"
@using LuxfordPTAWeb.Shared.Models
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,BoardMember")]
@inject HttpClient Http
@inject NavigationManager NavigationManager

<PageTitle>Manage Sponsors</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-award"></i> Manage Sponsors</h1>
    <div>
        <a href="/admin" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
        <a href="/sponsors" class="btn btn-outline-info">
            <i class="bi bi-eye"></i> View Public Page
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="row">
    <div class="col-lg-7 mb-4">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Sponsors</strong>
            </div>
            <div class="card-body">
                @if (sponsors == null)
                {
                    <div class="text-muted">Loading sponsors...</div>
                }
                else if (!sponsors.Any())
                {
                    <div class="text-muted">No sponsors found.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Logo</th>
                                    <th>Website</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sponsor in sponsors)
                                {
                                    <tr class="@(editingSponsor?.Id == sponsor.Id ? "table-primary" : string.Empty)">
                                        <td>@sponsor.Name</td>
                                        <td class="text-truncate" style="max-width: 180px;">@sponsor.LogoUrl</td>
                                        <td class="text-truncate" style="max-width: 180px;">@sponsor.WebsiteUrl</td>
                                        <td class="text-end">
                                            <button class="btn btn-outline-secondary btn-sm me-2" @onclick="() => EditSponsor(sponsor)">
                                                Edit
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteSponsorAsync(sponsor)">
                                                Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5 mb-4">
        <div class="card shadow-sm">
            <div class="card-header">
                <strong>@(editingSponsor?.Id > 0 ? "Edit Sponsor" : "Add Sponsor")</strong>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <input class="form-control" @bind="editingSponsor!.Name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Logo URL</label>
                    <input class="form-control" @bind="editingSponsor.LogoUrl" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Website URL</label>
                    <input class="form-control" @bind="editingSponsor.WebsiteUrl" />
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" @onclick="SaveSponsorAsync">
                        Save
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="StartNewSponsor">
                        Clear
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Sponsor>? sponsors;
    private Sponsor editingSponsor = new();
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadSponsorsAsync();
        StartNewSponsor();
    }

    private async Task LoadSponsorsAsync()
    {
        try
        {
            sponsors = await Http.GetFromJsonAsync<List<Sponsor>>("api/sponsors") ?? new List<Sponsor>();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            sponsors = new List<Sponsor>();
        }
    }

    private void StartNewSponsor()
    {
        editingSponsor = new Sponsor();
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private void EditSponsor(Sponsor sponsor)
    {
        editingSponsor = new Sponsor
        {
            Id = sponsor.Id,
            Name = sponsor.Name,
            LogoUrl = sponsor.LogoUrl,
            WebsiteUrl = sponsor.WebsiteUrl
        };
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private async Task SaveSponsorAsync()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(editingSponsor.Name))
        {
            errorMessage = "Sponsor name is required.";
            return;
        }

        HttpResponseMessage response;
        if (editingSponsor.Id > 0)
        {
            response = await Http.PutAsJsonAsync($"api/sponsors/{editingSponsor.Id}", editingSponsor);
        }
        else
        {
            response = await Http.PostAsJsonAsync("api/sponsors", editingSponsor);
        }

        if (!response.IsSuccessStatusCode)
        {
            errorMessage = await response.Content.ReadAsStringAsync();
            return;
        }

        successMessage = "Sponsor saved.";
        await LoadSponsorsAsync();
        StartNewSponsor();
    }

    private async Task DeleteSponsorAsync(Sponsor sponsor)
    {
        var response = await Http.DeleteAsync($"api/sponsors/{sponsor.Id}");
        if (!response.IsSuccessStatusCode)
        {
            errorMessage = await response.Content.ReadAsStringAsync();
            return;
        }

        successMessage = "Sponsor deleted.";
        await LoadSponsorsAsync();
        if (editingSponsor.Id == sponsor.Id)
        {
            StartNewSponsor();
        }
    }
}
