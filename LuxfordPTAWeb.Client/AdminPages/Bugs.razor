@page "/admin/bugs"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,BoardMember")]
@using LuxfordPTAWeb.Shared.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization

@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Bug Reports - Summit Proposals</PageTitle>

<h2 class="mb-3"><i class="bi bi-bug me-2"></i> Summit Proposals: Bug Reports</h2>

<div class="mb-3 d-flex flex-wrap gap-3 align-items-end">
    <div>
        <label class="form-label">Page Route</label>
        <input class="form-control" @bind="filterPageRoute" placeholder="/events, /admin, etc." />
    </div>
    <div>
        <label class="form-label">Status</label>
        <select class="form-select" @bind="filterStatus">
            <option value="">All</option>
            <option value="Functional">Functional</option>
            <option value="Broken">Broken</option>
            <option value="Needs Enhancement">Needs Enhancement</option>
            <option value="Confusing UX">Confusing UX</option>
        </select>
    </div>
    <div>
        <label class="form-label">Submitter</label>
        <input class="form-control" @bind="filterSubmitter" placeholder="Name or email" />
    </div>
    <button class="btn btn-outline-primary" @onclick="Reload">Filter</button>
    <button class="btn btn-outline-secondary" @onclick="SeeAllBugs">See All Bugs</button>
</div>

@if (isLoading)
{
    <div class="text-center py-4">
        <div class="spinner-border" role="status"></div>
        <p class="mt-2">Loading summit proposals...</p>
    </div>
}
else if (filteredReports.Count == 0)
{
    <div class="alert alert-info">No summit proposals found. The dragons sleep... for now.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Page Name</th>
                    <th>Route</th>
                    <th>Status</th>
                    <th>Submitted By</th>
                    <th>Submitted At</th>
                    <th>Resolved</th>
                    @if (isAdmin)
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var bug in filteredReports)
                {
                    <tr>
                        <td>@bug.PageName</td>
                        <td>@bug.PageRoute</td>
                        <td>@bug.Status</td>
                        <td>@bug.SubmittedBy</td>
                        <td>@bug.SubmittedAt.ToLocalTime().ToString("g")</td>
                        <td>
                            @if (bug.IsResolved)
                            {
                                <span class="badge bg-success">Done</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Open</span>
                            }
                        </td>
                        @if (isAdmin)
                        {
                            <td>
                        @if (!bug.IsResolved)
                        {
                            <button class="btn btn-sm btn-success me-1" @onclick="() => MarkResolved(bug.Id)"><i class="bi bi-check-lg"></i> Mark as Done</button>
                        }
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEditModal(bug)"><i class="bi bi-pencil"></i> Edit</button>
                            </td>
                        }
                    </tr>
                    <tr class="bg-light">
                        <td colspan="@(isAdmin ? 7 : 6)" style="white-space:pre-line;">
                            <div class="mb-2"><strong>Description:</strong> <span class="text-dark">@bug.Description</span></div>
                            @if (!string.IsNullOrWhiteSpace(bug.Suggestion))
                            {
                                <div class="mb-2"><strong>Suggestion:</strong> <span class="text-dark">@bug.Suggestion</span></div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<BugReport> allReports = new();
    private List<BugReport> filteredReports = new();
    private bool isLoading = true;
    private bool isAdmin = false;

    private string filterPageRoute = "";
    private string filterStatus = "";
    private string filterSubmitter = "";

    // Edit modal state
    private bool isEditModalOpen = false;
    private BugReport? editBug = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadReports();
        await GetUserRole();
        FilterReports();
    }

    private async Task LoadReports()
    {
        isLoading = true;
        try
        {
            allReports = await Http.GetFromJsonAsync<List<BugReport>>("api/bugreports/all") ?? new();
        }
        catch
        {
            allReports = new();
        }
        isLoading = false;
    }

    private async Task GetUserRole()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("Admin");
    }

    private void FilterReports()
    {
        filteredReports = allReports
            .Where(b => (string.IsNullOrWhiteSpace(filterPageRoute) || b.PageRoute.Contains(filterPageRoute, StringComparison.OrdinalIgnoreCase))
                && (string.IsNullOrWhiteSpace(filterStatus) || b.Status == filterStatus)
                && (string.IsNullOrWhiteSpace(filterSubmitter) || b.SubmittedBy.Contains(filterSubmitter, StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(b => b.SubmittedAt)
            .ToList();
    }

    private async Task Reload()
    {
        await LoadReports();
        FilterReports();
    }

    private async Task MarkResolved(int id)
    {
        var resp = await Http.PutAsync($"api/bugreports/{id}/resolve", null);
        if (resp.IsSuccessStatusCode)
        {
            var bug = allReports.FirstOrDefault(b => b.Id == id);
            if (bug != null) bug.IsResolved = true;
            FilterReports();
        }
    }

    private async Task SeeAllBugs()
    {
        filterPageRoute = "";
        filterStatus = "";
        filterSubmitter = "";
        await Reload();
    }

    private void OpenEditModal(BugReport bug)
    {
        // Clone to avoid editing the list directly
        editBug = new BugReport
        {
            Id = bug.Id,
            PageName = bug.PageName,
            PageRoute = bug.PageRoute,
            Status = bug.Status,
            Description = bug.Description,
            Suggestion = bug.Suggestion,
            SubmittedBy = bug.SubmittedBy,
            SubmittedAt = bug.SubmittedAt,
            IsResolved = bug.IsResolved
        };
        isEditModalOpen = true;
    }

    private void CloseEditModal()
    {
        isEditModalOpen = false;
        editBug = null;
    }

    private async Task SaveEdit()
    {
        if (editBug == null) return;
        var resp = await Http.PutAsJsonAsync($"api/bugreports/{editBug.Id}", editBug);
        if (resp.IsSuccessStatusCode)
        {
            // Update the local list
            var bug = allReports.FirstOrDefault(b => b.Id == editBug.Id);
            if (bug != null)
            {
                bug.Status = editBug.Status;
                bug.Description = editBug.Description;
                bug.Suggestion = editBug.Suggestion;
            }
            FilterReports();
            CloseEditModal();
        }
    }
}

@if (isEditModalOpen && editBug != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-info-subtle">
                    <h5 class="modal-title">Edit Summit Proposal</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="editBug" OnValidSubmit="SaveEdit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="mb-2">
                            <label class="form-label">Status</label>
                            <InputSelect class="form-select" @bind-Value="editBug.Status">
                                <option value="Functional">Functional</option>
                                <option value="Broken">Broken</option>
                                <option value="Needs Enhancement">Needs Enhancement</option>
                                <option value="Confusing UX">Confusing UX</option>
                            </InputSelect>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" @bind-Value="editBug.Description" rows="3" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Suggestion</label>
                            <InputTextArea class="form-control" @bind-Value="editBug.Suggestion" rows="2" />
                        </div>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}
