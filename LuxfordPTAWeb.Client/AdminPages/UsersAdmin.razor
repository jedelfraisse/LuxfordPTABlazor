@page "/admin/users"
@using LuxfordPTAWeb.Shared.Models
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>User Management</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
	<h1><i class="bi bi-people"></i> User Management</h1>
	<a href="/admin" class="btn btn-outline-secondary">
		<i class="bi bi-arrow-left"></i> Back to Dashboard
	</a>
</div>

@if (isLoading)
{
	<div class="text-center my-5">
		<div class="spinner-border text-primary" role="status">
			<span class="visually-hidden">Loading users...</span>
		</div>
	</div>
}
else
{
	<div class="card shadow-sm">
		<div class="card-header bg-light">
			<h5 class="mb-0"><i class="bi bi-list"></i> All Users (@users.Count)</h5>
		</div>
		<div class="card-body">
			@if (!users.Any())
			{
				<div class="alert alert-info">
					<i class="bi bi-info-circle"></i> No users found.
				</div>
			}
			else
			{
				<div class="table-responsive">
					<table class="table table-hover">
						<thead>
							<tr>
								<th>Name</th>
								<th>Email</th>
								<th>Phone</th>
								<th>Roles</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var user in users.OrderBy(u => u.LastName).ThenBy(u => u.FirstName))
							{
								<tr>
									<td>
										<strong>@user.FirstName @user.LastName</strong>
										@if (!string.IsNullOrEmpty(user.PreferredName))
										{
											<br><small class="text-muted">Preferred: @user.PreferredName</small>
										}
									</td>
									<td>@user.Email</td>
									<td>@user.PhoneNumber</td>
									<td>
										<span class="badge bg-secondary">User</span>
										<!-- TODO: Add role management -->
									</td>
									<td>
										<button class="btn btn-sm btn-outline-primary" @onclick="() => EditUser(user)">
											<i class="bi bi-pencil"></i> Edit
										</button>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</div>
}

@code {
	private List<ApplicationUser> users = new();
	private bool isLoading = true;

	protected override async Task OnInitializedAsync()
	{
		await LoadUsersAsync();
	}

	private async Task LoadUsersAsync()
	{
		isLoading = true;
		try
		{
			users = await Http.GetFromJsonAsync<List<ApplicationUser>>("api/users") ?? new();
		}
		catch (Exception ex)
		{
			await JS.InvokeVoidAsync("alert", $"Error loading users: {ex.Message}");
		}
		finally
		{
			isLoading = false;
		}
	}

	private void EditUser(ApplicationUser user)
	{
		// TODO: Implement user editing
		JS.InvokeVoidAsync("alert", $"User editing for {user.FirstName} {user.LastName} coming soon!");
	}
}
