                                                    <input class="form-check-input" type="checkbox" @bind="day.IsActive" />
                                                    <label class="form-check-label small">Active</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (originalEventDays.Count > 1)
                {
                    <div class="card mb-4 border-warning">
                        <div class="card-body text-center py-4">
                            <h6 class="text-muted mb-3"><i class="bi bi-calendar-plus"></i> This was originally a @originalEventDays.Count-day event</h6>
                            <button type="button" class="btn btn-outline-warning" @onclick="RestoreAdditionalDays">
                                <i class="bi bi-arrow-clockwise"></i> Restore Additional Days
                            </button>
                            <p class="text-muted small mt-2">Click to restore the additional days from the original event</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card mb-4 border-info">
                        <div class="card-body text-center py-4">
                            <h6 class="text-muted mb-3"><i class="bi bi-calendar-plus"></i> Convert to multi-day event?</h6>
                            <button type="button" class="btn btn-outline-info" @onclick="AddAdditionalDay">
                                <i class="bi bi-plus-circle"></i> Add Additional Days
                            </button>
                            <p class="text-muted small mt-2">Perfect for events like Fire Prevention Week, Book Fair, Spirit Week, etc.</p>
                        </div>
                    </div>
                }
            }
            else if (selectedOpsTab == "controls")
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-broadcast"></i> Event Helpers</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-text mb-3">
                            The director manages event flow and status. Additional helpers support displays, agendas, notes, and other event tasks.
                        </div>
                        @if (string.IsNullOrWhiteSpace(selectedDirectorControlType))
                        {
                            <div class="row g-2 align-items-end mb-3">
                                <div class="col-md-8">
                                    <label class="form-label">Event Director</label>
                                    <select class="form-select" @bind="selectedDirectorControlType" @bind:after="ApplyDirectorSelection">
                                        <option value="">No Director (Optional)</option>
                                        @foreach (var directorType in directorControlTypes)
                                        {
                                            <option value="@directorType">@GetControlTypeLabel(directorType)</option>
                                        }
                                    </select>
                                    <div class="form-text">Director is optional for simple events. Only one director helper is allowed.</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <div class="form-text text-warning">If you want to change the director, remove it first.</div>
                            </div>
                        }

                        @{
                            var availableNonDirectorControlTypes = GetAvailableNonDirectorControlTypes().ToList();
                        }
                        @if (availableNonDirectorControlTypes.Any())
                        {
                            <div class="row g-2 align-items-end mb-3">
                                <div class="col-md-8">
                                    <label class="form-label">Add Additional Helper</label>
                                    <select class="form-select" @bind="selectedNonDirectorControlType">
                                        @foreach (var controlType in availableNonDirectorControlTypes)
                                        {
                                            <option value="@controlType">@GetControlTypeLabel(controlType)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <button type="button" class="btn btn-outline-primary w-100" @onclick="AddNonDirectorControl" disabled="@string.IsNullOrWhiteSpace(selectedNonDirectorControlType)">
                                        Add Helper
                                    </button>
                                </div>
                            </div>
                        }

                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Order</th>
                                        <th>Type</th>
                                        <th>Role</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (eventModel.EventControls.Any())
                                    {
                                        @foreach (var control in eventModel.EventControls.OrderBy(c => c.SequenceOrder))
                                        {
                                            <tr>
                                                <td>@control.SequenceOrder</td>
                                                <td><code>@GetControlTypeLabel(control.ControlType)</code></td>
                                                <td>@(control.IsDirector ? "Director" : "Helper")</td>
                                                <td>
                                                    <input class="form-check-input" type="checkbox" @bind="control.IsActive" />
                                                </td>
                                                <td class="text-end">
                                                    <a class="btn btn-outline-primary btn-sm me-2" href="@GetControlPageUrl(control)">Open</a>
                                                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => RemoveControl(control)">
                                                        Remove
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="text-muted">No helpers configured yet.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (GetNoteControls().Any())
                        {
                            <div class="card mt-3 border-info">
                                <div class="card-header bg-info text-white">
                                    <strong>Note Taker Notes</strong>
                                </div>
                                <div class="card-body">
                                    @foreach (var noteControl in GetNoteControls())
                                    {
                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <strong>@noteControl.DisplayName</strong>
                                                <span class="badge @(noteControl.PublicInformation ? "bg-success" : "bg-secondary")">
                                                    @(noteControl.PublicInformation ? "Public" : "Private")
                                                </span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(noteControl.NotesMarkdown))
                                            {
                                                <div class="mt-2">
                                                    <BlazorMarkdown.Markdown Content="@noteControl.NotesMarkdown" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-muted mt-2">No notes entered yet.</div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (selectedOpsTab == "volunteers")
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-people"></i> Volunteers</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="requiresVolunteers" @bind="eventModel.RequiresVolunteers">
                            <label class="form-check-label" for="requiresVolunteers">
                                Volunteers Needed
                            </label>
                        </div>
                        @if (eventModel.RequiresVolunteers)
                        {
                            <div class="card border-warning">
                                <div class="card-header">
                                    <strong><i class="bi bi-people"></i> Volunteer Details</strong>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label class="form-label">Volunteer Signup Link</label>
                                        <input type="url" class="form-control" @bind="eventModel.ExcelImportId" placeholder="https://www.signupgenius.com/go/..." />
                                        <div class="form-text">Store the volunteer signup URL for this event.</div>
                                    </div>
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label">Signup Opens</label>
                                            <input type="datetime-local" class="form-control" @bind="eventModel.SignupWindowStart" @bind:format="yyyy-MM-ddTHH:mm" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Signup Closes</label>
                                            <input type="datetime-local" class="form-control" @bind="eventModel.SignupWindowEnd" @bind:format="yyyy-MM-ddTHH:mm" />
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(eventModel.ExcelImportId))
                                    {
                                        <div class="alert alert-info mb-0">
                                            <a href="@eventModel.ExcelImportId" target="_blank">View Volunteer Signup</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-light border mb-0">Volunteers are currently disabled for this event.</div>
                        }
                    </div>
                </div>
            }

            </div>

        <!-- Action Panel -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-gear"></i> Actions</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="changeNotes" class="form-label">Change Notes (optional)</label>
                        <textarea class="form-control" id="changeNotes" rows="3" @bind="changeNotes" placeholder="Describe what you changed and why..."></textarea>
                        <div class="form-text">These notes will be saved in the event history</div>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-success" @onclick="SaveEvent" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            <i class="bi bi-save"></i> Save Changes
                        </button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">
                            <i class="bi bi-x-circle"></i> Cancel
                        </button>
                    </div>
                    
                    <!-- Event Summary -->
                    <hr />
                    <h6>Event Summary</h6>
                    <ul class="list-unstyled small">
                        <li><strong>Total Days:</strong> @(1 + additionalDays.Count)</li>
                        <li><strong>Date Range:</strong> 
                            @{
                                var allEventDays = new List<EventDay> { primaryDay };
                                allEventDays.AddRange(additionalDays);
                                
                                if (allEventDays.Count > 1 && allEventDays.Any())
                                {
                                    var startDate = allEventDays.Min(d => d.Date);
                                    var endDate = allEventDays.Max(d => d.Date);
                                    <span>@startDate.ToString("MMM d") - @endDate.ToString("MMM d, yyyy")</span>
                                }
                                else if (primaryDay.Date != DateTime.MinValue)
                                {
                                    <span>@primaryDay.Date.ToString("MMM d, yyyy")</span>
                                }
                                else
                                {
                                    <span class="text-muted">Not set</span>
                                }
                            }
                        </li>
                        <li><strong>Status:</strong> <span class="badge bg-secondary">@eventModel.Status</span></li>
                        @if (primaryDayIsAllDay && additionalDays.All(d => GetIsAllDay(d)))
                        {
                            <li><strong>Time:</strong> <span class="text-muted">All Day</span></li>
                        }
                        else if (!primaryDayIsAllDay)
                        {
                            <li><strong>Primary Day Time:</strong> @primaryDayStartTime - @primaryDayEndTime</li>
                        }
                    </ul>
                </div>
            </div>
            
            <!-- Event History Card -->
            @if (!string.IsNullOrEmpty(eventModel.CreatedBy))
            {
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="bi bi-clock-history"></i> Event History</h6>
                    </div>
                    <div class="card-body py-3">
                        <div class="mb-2">
                            <small><strong>Created:</strong></small><br>
                            <small>@eventModel.CreatedOn.ToString("MMM d, yyyy 'at' h:mm tt")</small><br>
                            <small class="text-muted">by @eventModel.CreatedBy.GetDisplayName()</small>
                        </div>
                        @if (eventModel.LastEditedOn != eventModel.CreatedOn)
                        {
                            <div class="mb-2">
                                <small><strong>Last Modified:</strong></small><br>
                                <small>@eventModel.LastEditedOn.ToString("MMM d, yyyy 'at' h:mm tt")</small><br>
                                <small class="text-muted">by @eventModel.LastEditedBy.GetDisplayName()</small>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(eventModel.ChangeNotes) && eventModel.ChangeNotes != "Initial creation")
                        {
                            <div class="mt-2 p-2 bg-light rounded">
                                <small><strong>Last Change:</strong></small><br>
                                <small class="text-muted">@eventModel.ChangeNotes</small>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        <em>Event not found or you don't have permission to edit it.</em>
    </div>
}
