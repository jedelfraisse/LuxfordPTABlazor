@page "/programs/{ProgramSlug}"
@using LuxfordPTAWeb.Shared.Models
@using Microsoft.AspNetCore.Components
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>@(program?.ProgramTitle ?? "Program Details")</PageTitle>

@if (isLoading)
{
	<div class="text-center my-5">
		<div class="spinner-border text-primary" role="status">
			<span class="visually-hidden">Loading program details...</span>
		</div>
		<p class="mt-2 text-muted">Loading program details...</p>
	</div>
}
else if (program == null)
{
	<div class="alert alert-warning">
		<h4 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i>Program Not Found</h4>
		<p>Sorry, we couldn't find the program you're looking for.</p>
		<hr>
		<NavLink href="/programs" class="btn btn-primary">
			<i class="bi bi-arrow-left me-1"></i>Back to Programs
		</NavLink>
	</div>
}
else
{
	<!-- Program Header Card -->
	<div class="card shadow-sm mb-4">
		@if (!string.IsNullOrWhiteSpace(program.ImageUrl))
		{
			<img src="@program.ImageUrl" class="card-img-top" alt="@program.ProgramTitle" style="object-fit: cover;">
		}
		<div class="card-body">
			<h1 class="card-title mb-3">@program.ProgramTitle</h1>
			
			@if (!string.IsNullOrWhiteSpace(program.ShortDescription))
			{
				<p class="lead text-muted">@program.ShortDescription</p>
			}
			
			@if (!string.IsNullOrWhiteSpace(program.FlyerUrl))
			{
				<div class="mt-3">
					<a href="@program.FlyerUrl" target="_blank" class="btn btn-outline-primary">
						<i class="bi bi-file-earmark-pdf me-1"></i>View Flyer
					</a>
				</div>
			}
		</div>
	</div>

	<!-- Program Details Card -->
	@if (!string.IsNullOrWhiteSpace(program.LongDescription))
	{
		<div class="card shadow-sm mb-4">
			<div class="card-header bg-light">
				<h3 class="mb-0"><i class="bi bi-info-circle me-2"></i>Program Details</h3>
			</div>
			<div class="card-body">
				<div class="program-content markdown-content">
					@if (isRenderingMarkdown)
					{
						<div class="text-center">
							<small class="text-muted">Rendering content...</small>
						</div>
					}
					else if (renderedHtml != null)
					{
						@((MarkupString)renderedHtml)
					}
				</div>
			</div>
		</div>
	}
	
	<!-- Back Button -->
	<div class="d-flex justify-content-center mb-4">
		<NavLink href="/programs" class="btn btn-lg btn-primary">
			<i class="bi bi-arrow-left me-2"></i>Back to All Programs
		</NavLink>
	</div>
}

<!-- Custom Markdown Styling -->
<style>
	.markdown-content {
		line-height: 1.8;
	}
	
	.markdown-content h1 {
		font-size: 2rem;
		margin-top: 1.5rem;
		margin-bottom: 1rem;
		border-bottom: 2px solid #dee2e6;
		padding-bottom: 0.5rem;
	}
	
	.markdown-content h2 {
		font-size: 1.75rem;
		margin-top: 1.25rem;
		margin-bottom: 0.75rem;
		color: #495057;
	}
	
	.markdown-content h3 {
		font-size: 1.5rem;
		margin-top: 1rem;
		margin-bottom: 0.5rem;
		color: #6c757d;
	}
	
	.markdown-content p {
		margin-bottom: 1rem;
	}
	
	.markdown-content ul, .markdown-content ol {
		margin-bottom: 1rem;
		padding-left: 2rem;
	}
	
	.markdown-content li {
		margin-bottom: 0.5rem;
	}
	
	.markdown-content blockquote {
		border-left: 4px solid #0d6efd;
		padding-left: 1rem;
		margin: 1.5rem 0;
		color: #6c757d;
		font-style: italic;
	}
	
	.markdown-content code {
		background-color: #f8f9fa;
		padding: 0.2rem 0.4rem;
		border-radius: 0.25rem;
		font-family: 'Courier New', monospace;
		color: #d63384;
	}
	
	.markdown-content pre {
		background-color: #f8f9fa;
		padding: 1rem;
		border-radius: 0.375rem;
		overflow-x: auto;
	}
	
	.markdown-content pre code {
		background-color: transparent;
		padding: 0;
		color: inherit;
	}
	
	.markdown-content a {
		color: #0d6efd;
		text-decoration: underline;
	}
	
	.markdown-content a:hover {
		color: #0a58ca;
	}
	
	.markdown-content img {
		max-width: 100%;
		height: auto;
		border-radius: 0.375rem;
		margin: 1rem 0;
	}
	
	.markdown-content table {
		width: 100%;
		margin-bottom: 1rem;
		border-collapse: collapse;
	}
	
	.markdown-content table th,
	.markdown-content table td {
		padding: 0.75rem;
		border: 1px solid #dee2e6;
	}
	
	.markdown-content table thead {
		background-color: #f8f9fa;
	}
	
	.markdown-content hr {
		margin: 2rem 0;
		border: 0;
		border-top: 2px solid #dee2e6;
	}
</style>

@code {
	[Parameter]
	public string ProgramSlug { get; set; } = string.Empty;
	
	private ProgramCard? program;
	private string? renderedHtml;
	private bool isLoading = true;
	private bool isRenderingMarkdown = false;
	
	protected override async Task OnInitializedAsync()
	{
		await LoadProgramAsync();
	}
	
	protected override async Task OnParametersSetAsync()
	{
		await LoadProgramAsync();
	}
	
	private async Task LoadProgramAsync()
	{
		isLoading = true;
		program = null;
		renderedHtml = null;
		
		try
		{
			// Try to fetch from API by slug
			program = await Http.GetFromJsonAsync<ProgramCard>($"api/programcards/slug/{ProgramSlug}");
			
			// If program found and has long description, render the markdown
			if (program != null && !string.IsNullOrWhiteSpace(program.LongDescription))
			{
				await RenderMarkdownAsync(program.LongDescription);
			}
		}
		catch (HttpRequestException)
		{
			// Program not found or API error
			program = null;
		}
		finally
		{
			isLoading = false;
		}
	}
	
	private async Task RenderMarkdownAsync(string markdown)
	{
		isRenderingMarkdown = true;
		
		try
		{
			var request = new { markdown };
			var response = await Http.PostAsJsonAsync("api/markdown/to-html", request);
			
			if (response.IsSuccessStatusCode)
			{
				var result = await response.Content.ReadFromJsonAsync<MarkdownResponse>();
				renderedHtml = result?.Html;
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error rendering markdown: {ex.Message}");
		}
		finally
		{
			isRenderingMarkdown = false;
		}
	}
	
	private class MarkdownResponse
	{
		public string? Html { get; set; }
	}
}
