@page "/events"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject LuxfordPTAWeb.Client.Code.SchoolYearSupport SchoolYearSupport
@using LuxfordPTAWeb.Shared.Models
@using LuxfordPTAWeb.Shared.Enums
@using LuxfordPTAWeb.Shared.DTOs
@using LuxfordPTAWeb.Client.Code
@using LuxfordPTAWeb.Client.Components.Events

<PageTitle>Events - @(selectedSchoolYear?.Name ?? "Loading...")</PageTitle>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h1 class="card-title text-center mb-3">Events for @(selectedSchoolYear?.Name ?? "Loading...")!</h1>
        <p class="lead text-center mb-0">
            @if (isCurrentSchoolYear)
            {
                <span>Welcome to the events page for Luxford Elementary School. Here you'll find both PTA and school events &mdash; browse the calendar or by category, and use the search box to narrow either view down.</span>
            }
            else
            {
                <span>Here are the events that helped make @selectedSchoolYear?.Name a great year at Luxford Elementary. Browse the calendar or by category to see what happened!</span>
            }
        </p>
    </div>
</div>

@if (!string.IsNullOrEmpty(selectedSchoolYear?.PrintableEventCalendar))
{
    <div class="alert alert-primary text-center mb-4">
        <h5 class="mb-2">📅 <strong><a href="@selectedSchoolYear.PrintableEventCalendar" target="_blank">Download Printable Event Calendar →</a></strong></h5>
        <em>Print and post this handy calendar with all events for the @selectedSchoolYear.Name school year!</em>
    </div>
}

@if (isCurrentSchoolYear)
{
    <h2 class="h4 mt-4">📅 Coming Up Next</h2>
    @if (upcomingEvents == null)
    {
        <div class="alert alert-info">
            <em>Loading upcoming events...</em>
        </div>
    }
    else if (!upcomingEvents.Any())
    {
        <div class="alert alert-warning">
            <em>No upcoming events in the next 30 days.</em>
        </div>
    }
    else
    {
        <div class="row mb-4">
            @foreach (var evt in upcomingEvents.Take(3))
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card h-100 border-start border-4" style="border-left-color: @EventDisplayHelpers.GetBorderColorHex(evt.EventCatColorClass) !important;">
                        <div class="card-body">
                            <h6 class="card-title">@evt.Title</h6>
                            <p class="text-muted mb-2">
                                <i class="bi bi-calendar"></i> @evt.Date.ToString("MMMM d, yyyy")
                                @if (!string.IsNullOrWhiteSpace(EventDisplayHelpers.GetEventTimeText(evt)))
                                {
                                    <span class="ms-1"><i class="bi bi-clock"></i> @EventDisplayHelpers.GetEventTimeText(evt)</span>
                                }
                                @if (EventDisplayHelpers.IsToday(evt)) {<span class="badge bg-warning ms-2">Tonight!</span>}
                            </p>
                            @if (!string.IsNullOrWhiteSpace(evt.Location))
                            {
                                <p class="text-muted mb-2">
                                    <i class="bi bi-geo-alt"></i> @evt.Location
                                </p>
                            }
                            @if (evt.RequiresVolunteers)
                            {
                                <p class="text-muted mb-2">
                                    <i class="bi bi-people"></i>
                                    @if (!string.IsNullOrWhiteSpace(evt.ExcelImportId))
                                    {
                                        <a href="@evt.ExcelImportId" target="_blank" rel="noopener noreferrer">Volunteer signup</a>
                                    }
                                    else
                                    {
                                        <span>@EventDisplayHelpers.GetVolunteerSignupText(evt)</span>
                                    }
                                </p>
                            }
                            @if (!string.IsNullOrWhiteSpace(evt.EventCatName))
                            {
                                <span class="badge bg-light text-dark">@evt.EventCatName</span>
                            }
                            @if (EventDisplayHelpers.HasDetailsOrFlyer(evt))
                            {
                                <div class="mt-2 d-flex gap-2 flex-wrap">
                                    @if (EventDisplayHelpers.GetFlyerUrls(evt).Any())
                                    {
                                        <a class="btn btn-sm btn-outline-primary" href="@EventDisplayHelpers.GetPrimaryFlyerUrl(evt)" target="_blank" rel="noopener noreferrer">View Flyer</a>
                                    }
                                    @if (EventDisplayHelpers.HasEventDetails(evt))
                                    {
                                        <a class="btn btn-sm btn-outline-primary" href="@EventDisplayHelpers.GetEventDetailsUrl(evt)">View Details</a>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    <h2 class="h4 mt-4">📅 Past Events from @selectedSchoolYear?.Name</h2>
}

<!-- Tabs: Calendar / Categories -->
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <button class="nav-link @(activeTab == EventsTab.Calendar ? "active" : "")" @onclick='() => SetActiveTab(EventsTab.Calendar)'>
            <i class="bi bi-calendar3"></i> Calendar
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == EventsTab.Categories ? "active" : "")" @onclick='() => SetActiveTab(EventsTab.Categories)'>
            <i class="bi bi-grid-3x3-gap"></i> Categories
        </button>
    </li>
</ul>

<EventsFilterBar Categories="eventCategories"
                  SearchText="searchText" SearchTextChanged="OnSearchTextChanged"
                  SelectedCategoryId="selectedCategoryId" SelectedCategoryIdChanged="OnSelectedCategoryIdChanged" ShowCategoryFilter="activeTab == EventsTab.Calendar"
                  VolunteersOnly="volunteersOnly" VolunteersOnlyChanged="OnVolunteersOnlyChanged"
                  TimeFilter="timeFilter" TimeFilterChanged="OnTimeFilterChanged" ShowTimeFilter="activeTab == EventsTab.Categories && isCurrentSchoolYear"
                  ResultCount="FilteredEvents.Count" TotalCount="allEvents?.Count ?? 0" />

@if (allEvents == null)
{
    <div class="alert alert-info">
        <em>Loading events...</em>
    </div>
}
else if (activeTab == EventsTab.Calendar)
{
    <EventsCalendarTab Events="FilteredEvents" SchoolYear="selectedSchoolYear" IsCurrentSchoolYear="isCurrentSchoolYear" IsFiltered="HasActiveFilters" />
}
else
{
    <h2 class="h4 mt-2">Event Categories</h2>
    <EventsCategoriesTab EventCategories="eventCategories" EventSubcategories="eventSubcategories" AllEvents="FilteredEvents" IsCurrentSchoolYear="isCurrentSchoolYear" SelectedSchoolYear="selectedSchoolYear" IsFiltered="HasActiveFilters" />
}

@if (showGetInvolved)
{
    <div class="card mb-4">
        <div class="card-header bg-primary text-white fw-bold">🙋‍♀️ Get Involved</div>
        <div class="card-body">
            <p>We're always looking for volunteers to help make our events successful! Contact our @contactPersonTitle: @contactPersonName</p>
            @if (!string.IsNullOrEmpty(contactPersonEmail))
            {
                <p class="mb-0"><strong>Email:</strong> <a href="mailto:@contactPersonEmail">@contactPersonEmail</a></p>
            }
        </div>
    </div>
}

<div class="alert alert-success text-center mt-4">
    <em>@(isCurrentSchoolYear ? "Mark your calendars and join us for these wonderful community events!" : $"These events helped make {selectedSchoolYear?.Name} a great year!")</em><br />
    @if (isCurrentSchoolYear)
    {
        <span><strong>Email List</strong> - Contact us at: TBD</span>
    }
</div>

@code {
    private enum EventsTab { Calendar, Categories }

    [SupplyParameterFromQuery(Name = "tab")]
    private string? TabQuery { get; set; }

    private EventsTab activeTab = EventsTab.Calendar;

    private List<EventListItemDTO>? upcomingEvents;
    private List<EventCat>? eventCategories;
    private List<EventCatSub>? eventSubcategories;
    private List<EventListItemDTO>? allEvents;
    private SchoolYear? selectedSchoolYear;
    private bool isCurrentSchoolYear = false;
    private bool showGetInvolved = false;
    private string contactPersonTitle = "Event Coordinator";
    private string contactPersonName = "PTA Board";
    private string contactPersonEmail = string.Empty;

    // Shared filters used by both the Calendar and Categories tabs
    private string searchText = string.Empty;
    private int? selectedCategoryId;
    private bool volunteersOnly;
    private EventTimeFilter timeFilter = EventTimeFilter.All;

    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(searchText) || selectedCategoryId.HasValue || volunteersOnly || timeFilter != EventTimeFilter.All;

    private List<EventListItemDTO> FilteredEvents
    {
        get
        {
            IEnumerable<EventListItemDTO> query = allEvents ?? Enumerable.Empty<EventListItemDTO>();

            if (selectedCategoryId.HasValue)
            {
                query = query.Where(e => e.EventCatId == selectedCategoryId.Value);
            }

            if (volunteersOnly)
            {
                query = query.Where(e => e.RequiresVolunteers);
            }

            if (timeFilter == EventTimeFilter.Upcoming)
            {
                query = query.Where(e => e.Date >= DateTime.Now.Date);
            }
            else if (timeFilter == EventTimeFilter.Past)
            {
                query = query.Where(e => e.Date < DateTime.Now.Date);
            }

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var term = searchText.Trim();
                query = query.Where(e =>
                    Contains(e.Title, term) ||
                    Contains(e.Description, term) ||
                    Contains(e.DescriptionMarkdown, term) ||
                    Contains(e.Location, term) ||
                    Contains(e.EventCatName, term) ||
                    Contains(e.EventSubCatName, term));
            }

            return query.OrderBy(e => e.Date).ToList();
        }
    }

    private static bool Contains(string? haystack, string needle)
    {
        return !string.IsNullOrWhiteSpace(haystack) && haystack.Contains(needle, StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync()
    {
        activeTab = TabQuery?.ToLowerInvariant() switch
        {
            "categories" => EventsTab.Categories,
            _ => EventsTab.Calendar
        };

        // Get the selected school year from the header/localStorage
        selectedSchoolYear = await SchoolYearSupport.GetSelectedSchoolYearInfoAsync();

        if (selectedSchoolYear != null)
        {
            // Determine if this is the current school year
            isCurrentSchoolYear = selectedSchoolYear.Status == SchoolYearStatus.CurrentYear;
            showGetInvolved = isCurrentSchoolYear;

            await LoadEventCategories();
            await LoadEventSubcategories();
            await LoadAllEvents();

            if (isCurrentSchoolYear)
            {
                await LoadUpcomingEvents();
            }

            if (showGetInvolved)
            {
                await LoadContactPerson();
            }
        }
    }

    private void SetActiveTab(EventsTab tab)
    {
        if (activeTab == tab) return;
        activeTab = tab;

        // Category filter only applies on Calendar; the When filter only applies on Categories
        // (Categories is already organized by category, and Calendar already shows the whole year).
        // Reset whichever one doesn't apply to the tab we're switching to.
        if (tab == EventsTab.Categories)
        {
            selectedCategoryId = null;
        }
        else
        {
            timeFilter = EventTimeFilter.All;
        }

        var tabName = tab == EventsTab.Categories ? "categories" : "calendar";
        var uri = NavigationManager.GetUriWithQueryParameter("tab", tabName);
        NavigationManager.NavigateTo(uri, forceLoad: false, replace: true);
    }

    private void OnSearchTextChanged(string value) => searchText = value;

    private void OnSelectedCategoryIdChanged(int? value) => selectedCategoryId = value;

    private void OnVolunteersOnlyChanged(bool value) => volunteersOnly = value;

    private void OnTimeFilterChanged(EventTimeFilter value) => timeFilter = value;

    private async Task LoadEventCategories()
    {
        try
        {
            eventCategories = await Http.GetFromJsonAsync<List<EventCat>>("api/eventcat");
        }
        catch (Exception)
        {
            eventCategories = new List<EventCat>();
        }
    }

    private async Task LoadEventSubcategories()
    {
        try
        {
            eventSubcategories = await Http.GetFromJsonAsync<List<EventCatSub>>("api/eventcatsub");
        }
        catch (Exception)
        {
            eventSubcategories = new List<EventCatSub>();
        }
    }

    private async Task LoadUpcomingEvents()
    {
        if (selectedSchoolYear == null) return;

        try
        {
            // Get upcoming events for the current school year
            var events = await Http.GetFromJsonAsync<List<EventListItemDTO>>($"api/events/by-school-year/{selectedSchoolYear.Id}");

            var now = DateTime.UtcNow.Date;
            var in30Days = now.AddDays(30);

            upcomingEvents = events?
                .Where(e => e.Date >= now && e.Date <= in30Days)
                .OrderBy(e => e.Date)
                .ToList() ?? new List<EventListItemDTO>();
        }
        catch (Exception)
        {
            upcomingEvents = new List<EventListItemDTO>();
        }
    }

    private async Task LoadAllEvents()
    {
        if (selectedSchoolYear == null) return;

        try
        {
            // Get all events for the selected school year
            if (isCurrentSchoolYear)
            {
                // For current year, only get active events
                allEvents = await Http.GetFromJsonAsync<List<EventListItemDTO>>($"api/events/by-school-year/{selectedSchoolYear.Id}");
            }
            else
            {
                // For past years, we need all events (including completed), use admin endpoint if available
                try
                {
                    allEvents = await Http.GetFromJsonAsync<List<EventListItemDTO>>($"api/events/all-admin?schoolYearId={selectedSchoolYear.Id}");
                    // Filter to show completed and active events for past years
                    allEvents = allEvents?
                        .Where(e => e.Status == EventStatus.Completed ||
                                   e.Status == EventStatus.Active)
                        .ToList() ?? new List<EventListItemDTO>();
                }
                catch
                {
                    // Fallback to public endpoint for past years
                    allEvents = await Http.GetFromJsonAsync<List<EventListItemDTO>>($"api/events/by-school-year/{selectedSchoolYear.Id}");
                }
            }
        }
        catch (Exception)
        {
            allEvents = new List<EventListItemDTO>();
        }
    }

    private async Task LoadContactPerson()
    {
        if (selectedSchoolYear == null) return;

        try
        {
            // Use the public board positions endpoint
            var boardPositions = await Http.GetFromJsonAsync<List<AssignedUserDTO>>($"api/boardpositions/public/by-schoolyear/{selectedSchoolYear.Id}");

            if (boardPositions?.Any() == true)
            {
                // Look for Event Coordinator first
                var eventCoordinator = boardPositions.FirstOrDefault(bp =>
                    bp.RoleTitle?.Contains("Event Coordinator", StringComparison.OrdinalIgnoreCase) == true ||
                    bp.RoleTitle?.Contains("VP of Volunteer Engagement", StringComparison.OrdinalIgnoreCase) == true);

                if (eventCoordinator != null)
                {
                    contactPersonTitle = eventCoordinator.RoleTitle ?? "Event Coordinator";
                    contactPersonName = eventCoordinator.DisplayName ?? "PTA Board";
                    // Don't expose email from public endpoint for privacy
                }
                else
                {
                    // Fall back to President
                    var president = boardPositions.FirstOrDefault(bp =>
                        bp.RoleTitle?.Contains("President", StringComparison.OrdinalIgnoreCase) == true);

                    if (president != null)
                    {
                        contactPersonTitle = "President";
                        contactPersonName = president.DisplayName ?? "PTA Board";
                    }
                }
            }
        }
        catch (Exception)
        {
            // Keep default values
        }
    }
}
