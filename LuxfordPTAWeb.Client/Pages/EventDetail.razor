@page "/events/{slug}"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using LuxfordPTAWeb.Shared.DTOs
@using LuxfordPTAWeb.Shared.Models

<PageTitle>@(eventItem?.Title ?? "Event Details")</PageTitle>

@if (isLoading)
{
    <div class="alert alert-info">
        <em>Loading event details...</em>
    </div>
}
else if (eventItem == null)
{
    <div class="alert alert-warning">
        <em>Event details were not found.</em>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">@eventItem.Title</h1>
        <a href="/events" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Back to Events
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <p class="text-muted mb-2">
                <i class="bi bi-calendar"></i> @eventItem.Date.ToString("MMMM d, yyyy")
                @if (!string.IsNullOrWhiteSpace(GetSingleDayTimeText(eventItem)))
                {
                    <span class="ms-1"><i class="bi bi-clock"></i> @GetSingleDayTimeText(eventItem)</span>
                }
            </p>

            @if (!string.IsNullOrWhiteSpace(eventItem.Location))
            {
                <p class="text-muted mb-2">
                    <i class="bi bi-geo-alt"></i> @eventItem.Location
                </p>
            }

            @if (eventItem.RequiresVolunteers)
            {
                <p class="text-muted mb-2">
                    <i class="bi bi-people"></i>
                    @if (!string.IsNullOrWhiteSpace(eventItem.ExcelImportId))
                    {
                        <a href="@eventItem.ExcelImportId" target="_blank" rel="noopener noreferrer">Volunteer signup</a>
                    }
                    else
                    {
                        <span>@GetVolunteerSignupText(eventItem)</span>
                    }
                </p>
            }

            @if (HasPublishedTalentShowSignups(eventItem))
            {
                <p class="mb-0">
                    <a class="btn btn-outline-primary btn-sm" href="@GetTalentShowSignupHref(eventItem)">
                        <i class="bi bi-mic"></i> Performer Sign-Up
                    </a>
                </p>
            }

        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(eventItem.DescriptionHtml))
    {
        <div class="card mb-4">
            <div class="card-header"><strong>Description</strong></div>
            <div class="card-body">
                @((MarkupString)eventItem.DescriptionHtml)
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(eventItem.DescriptionMarkdown))
    {
        <div class="card mb-4">
            <div class="card-header"><strong>Description</strong></div>
            <div class="card-body">
                <BlazorMarkdown.Markdown Content="@eventItem.DescriptionMarkdown" />
            </div>
        </div>
    }
    
    @if (!string.IsNullOrWhiteSpace(eventItem.MoreDetailsHtml))
    {
        <div class="card mb-4">
            <div class="card-header"><strong>More Details</strong></div>
            <div class="card-body">
                @((MarkupString)eventItem.MoreDetailsHtml)
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(eventItem.MoreDetailsMarkdown))
    {
        <div class="card mb-4">
            <div class="card-header"><strong>More Details</strong></div>
            <div class="card-body">
                <BlazorMarkdown.Markdown Content="@eventItem.MoreDetailsMarkdown" />
            </div>
        </div>
    }

    @if (GetPublicNotes(eventItem).Any())
    {
        <div class="card mb-4 border-success">
            <div class="card-header"><strong>Public Notes</strong></div>
            <div class="card-body">
                @foreach (var note in GetPublicNotes(eventItem))
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>@note.DisplayName</strong>
                            <span class="badge bg-success">Public</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(note.NotesHtml))
                        {
                            <div class="mt-2">@((MarkupString)note.NotesHtml)</div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (GetPublicTryOutSessions(eventItem).Any())
    {
        <div class="card mb-4 border-success-subtle">
            <div class="card-header">
                <strong><i class="bi bi-mic"></i> Try-Out Sessions</strong>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var tryOutDay in GetPublicTryOutSessions(eventItem))
                    {
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                @if (!string.IsNullOrWhiteSpace(tryOutDay.DayTitle))
                                {
                                    <div class="fw-semibold mb-1">@tryOutDay.DayTitle</div>
                                }
                                <div class="text-muted">
                                    <i class="bi bi-calendar"></i> @tryOutDay.Date.ToString("ddd, MMM d, yyyy")
                                </div>
                                @if (!string.IsNullOrWhiteSpace(GetEventDayTimeText(tryOutDay)))
                                {
                                    <div class="text-muted">
                                        <i class="bi bi-clock"></i> @GetEventDayTimeText(tryOutDay)
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(tryOutDay.Location))
                                {
                                    <div class="text-muted">
                                        <i class="bi bi-geo-alt"></i> @tryOutDay.Location
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(tryOutDay.Description))
                                {
                                    <div class="small mt-2">@tryOutDay.Description</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (GetFlyerUrls(eventItem).Any())
    {
        <div class="card mb-4">
            <div class="card-header"><strong>Flyers</strong></div>
            <div class="card-body">
                @{
                    var flyerIndex = 1;
                }
                @foreach (var flyerUrl in GetFlyerUrls(eventItem))
                {
                    var flyerLabel = GetFlyerLabel(flyerUrl, flyerIndex);
                    <div class="mb-4">
                        @if (IsPdfFlyer(flyerUrl))
                        {
                            <div class="ratio ratio-16x9 border rounded">
                                <object data="@flyerUrl" type="application/pdf">
                                    <div class="p-3">
                                        <a href="@flyerUrl" target="_blank" rel="noopener noreferrer">Open PDF flyer</a>
                                    </div>
                                </object>
                            </div>
                        }
                        else if (IsImageFlyer(flyerUrl))
                        {
                            <img src="@flyerUrl" class="img-fluid rounded border" alt="@flyerLabel" />
                        }
                        else
                        {
                            <a href="@flyerUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary btn-sm">
                                Open Flyer
                            </a>
                        }
                    </div>
                    flyerIndex++;
                }
            </div>
        </div>
    }





}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    private Event? eventItem;
    private TalentShowSignupSettingsDTO? publicSignupSettings;
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        await LoadEvent();
    }

    private async Task LoadEvent()
    {
        isLoading = true;
        try
        {
            eventItem = await Http.GetFromJsonAsync<Event>($"api/events/by-slug/{Slug}");
            publicSignupSettings = null;
            if (eventItem != null)
            {
                publicSignupSettings = await LoadPublicSignupSettingsAsync(eventItem.Id);
            }
        }
        catch
        {
            eventItem = null;
            publicSignupSettings = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetSingleDayTimeText(Event evt)
    {
        if (evt.EventDays?.Count > 1)
        {
            return string.Empty;
        }

        if (evt.EventStartTime == default || evt.EventEndTime == default)
        {
            return string.Empty;
        }

        if (evt.EventStartTime.TimeOfDay == TimeSpan.Zero && evt.EventEndTime.TimeOfDay == TimeSpan.Zero)
        {
            return string.Empty;
        }

        if (evt.EventStartTime.TimeOfDay == evt.EventEndTime.TimeOfDay)
        {
            return evt.EventStartTime.ToString("h:mm tt");
        }

        return $"{evt.EventStartTime:h:mm tt} - {evt.EventEndTime:h:mm tt}";
    }

    private static string GetVolunteerSignupText(Event evt)
    {
        if (evt.SignupWindowStart.HasValue && evt.SignupWindowEnd.HasValue)
        {
            return $"Signups: {evt.SignupWindowStart.Value:MMM d h:mm tt} - {evt.SignupWindowEnd.Value:MMM d h:mm tt}";
        }

        if (evt.SignupWindowStart.HasValue)
        {
            return $"Signups open: {evt.SignupWindowStart.Value:MMM d h:mm tt}";
        }

        if (evt.SignupWindowEnd.HasValue)
        {
            return $"Signups close: {evt.SignupWindowEnd.Value:MMM d h:mm tt}";
        }

        return "Volunteers needed";
    }

    private async Task<TalentShowSignupSettingsDTO?> LoadPublicSignupSettingsAsync(int eventId)
    {
        try
        {
            return await Http.GetFromJsonAsync<TalentShowSignupSettingsDTO>($"/api/talentshow/{eventId}/public/signups/configure");
        }
        catch
        {
            return null;
        }
    }

    private bool HasPublishedTalentShowSignups(Event evt)
    {
        return evt.EventControls?.Any(c => c.IsActive && c.IsDirector && c.ControlType == "TalentShowDirectorControl") == true
            && publicSignupSettings?.IsPublished == true;
    }

    private static string GetTalentShowSignupHref(Event evt)
    {
        return $"/talent-show/signups/{evt.Id}";
    }

    private static IEnumerable<EventControl> GetPublicNotes(Event evt)
    {
        return evt.EventControls?
            .Where(c => c.IsActive && c.PublicInformation && !string.IsNullOrWhiteSpace(c.NotesHtml))
            .OrderBy(c => c.SequenceOrder)
            ?? Enumerable.Empty<EventControl>();
    }

    private static IEnumerable<EventDay> GetPublicTryOutSessions(Event evt)
    {
        return evt.EventDays?
            .Where(d => d.IsActive && d.IsFromTryOuts && d.PublicVisibleFromTryOuts)
            .OrderBy(d => d.Date)
            .ThenBy(d => d.StartTime ?? d.Date)
            ?? Enumerable.Empty<EventDay>();
    }

    private static string GetEventDayTimeText(EventDay day)
    {
        if (!day.StartTime.HasValue && !day.EndTime.HasValue)
        {
            return string.Empty;
        }

        if (day.StartTime.HasValue && day.EndTime.HasValue)
        {
            if (day.StartTime.Value.TimeOfDay == day.EndTime.Value.TimeOfDay)
            {
                return day.StartTime.Value.ToString("h:mm tt");
            }

            return $"{day.StartTime:h:mm tt} - {day.EndTime:h:mm tt}";
        }

        if (day.StartTime.HasValue)
        {
            return $"Starts {day.StartTime:h:mm tt}";
        }

        return $"Ends {day.EndTime:h:mm tt}";
    }

    private static IReadOnlyList<string> GetFlyerUrls(Event evt)
    {
        return evt.FlyerUrls;
    }

    private static string GetFlyerLabel(string flyerUrl, int index)
    {
        var fileName = flyerUrl.Split('?', '#')[0].Split('/').LastOrDefault();
        if (string.IsNullOrWhiteSpace(fileName))
        {
            return $"Flyer {index}";
        }

        return fileName;
    }

    private static bool IsPdfFlyer(string flyerUrl)
    {
        return flyerUrl.Split('?', '#')[0].EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsImageFlyer(string flyerUrl)
    {
        var url = flyerUrl.Split('?', '#')[0];
        return url.EndsWith(".png", StringComparison.OrdinalIgnoreCase)
            || url.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase)
            || url.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase)
            || url.EndsWith(".gif", StringComparison.OrdinalIgnoreCase)
            || url.EndsWith(".webp", StringComparison.OrdinalIgnoreCase);
    }
}
