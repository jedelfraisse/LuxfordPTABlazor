</div>

@code {
    [Parameter] public int EventId { get; set; }

    private TalentShowShowConfigDTO showConfig = new();
    private List<TalentShowAct> acts = [];
    private TalentShowAct editingAct = new() { DurationSeconds = 180, OrderIndex = 1, SelectedForShow = true };
    private TalentShowSegmentDTO editingSegment = new() { SegmentType = TalentShowSegmentType.HostTalk, ExpectedDurationSeconds = 180 };
    private TalentShowSegmentDTO newSegment = new() { SegmentType = TalentShowSegmentType.HostTalk, ExpectedDurationSeconds = 180 };
    private List<TalentShowConnectedDevice> connectedDevices = [];
    private HubConnection? hubConnection;
    private bool isHubConnected;
    private bool isLoading = true;
    private bool isSaving;
    private string activeTab = "status";
    private string hostNamesText = string.Empty;
    private string scoringCategoriesText = string.Empty;
    private string defaultSegmentDurationText = string.Empty;
    private string actDurationText = string.Empty;
    private string musicOffsetText = string.Empty;
    private string segmentDurationText = string.Empty;
    private bool showHostInsertMenu;
    private bool showPerformerInsertMenu;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private static readonly List<string> DefaultScoringCategories = new()
    {
        "Stage Presence",
        "Creativity",
        "Technical Skill",
        "Entertainment Value",
        "Overall Impression"
    };

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
        await EnsureHubConnectionAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            showConfig = await Http.GetFromJsonAsync<TalentShowShowConfigDTO>($"/api/talentshow/{EventId}/show/configure") ?? new TalentShowShowConfigDTO();
            acts = await Http.GetFromJsonAsync<List<TalentShowAct>>($"/api/talentshow/{EventId}/acts") ?? [];
            hostNamesText = string.Join('\n', showConfig.ShowSettings.HostNames);
            scoringCategoriesText = string.Join('\n', showConfig.ShowSettings.ScoringCategories);
            defaultSegmentDurationText = SecondsToMmSs(showConfig.ShowSettings.DefaultSegmentDurationSeconds);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading show configuration: {ex.Message}";
            showConfig = new TalentShowShowConfigDTO();
            acts = [];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveShowConfigAsync()
    {
        isSaving = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        showConfig.ShowSettings.HostNames = hostNamesText
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var scoringCategories = scoringCategoriesText
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (scoringCategories.Count == 0 && (showConfig.ShowSettings.JudgesVotingEnabled || showConfig.ShowSettings.AudienceVotingEnabled))
        {
            scoringCategories = DefaultScoringCategories;
        }

        showConfig.ShowSettings.ScoringCategories = scoringCategories;
        showConfig.ShowSettings.DefaultSegmentDurationSeconds = MmSsToSeconds(defaultSegmentDurationText);

        try
        {
            var response = await Http.PostAsJsonAsync($"/api/talentshow/{EventId}/show/configure", showConfig);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Failed to save show config.";
                return;
            }

            await SyncDisplayAssignmentsAsync();

            showConfig.ReadinessValidation = await Http.GetFromJsonAsync<TalentShowReadinessValidationDTO>($"/api/talentshow/{EventId}/show/configure/validation")
                ?? showConfig.ReadinessValidation;
            successMessage = "Show config saved.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving show config: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private string SecondsToMmSs(int seconds)
    {
        if (seconds <= 0) return "01:00";
        var minutes = seconds / 60;
        var secs = seconds % 60;
        return $"{minutes:D2}:{secs:D2}";
    }

    private int MmSsToSeconds(string mmSs)
    {
        if (string.IsNullOrWhiteSpace(mmSs)) return 60;
        var parts = mmSs.Split(':', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2 && int.TryParse(parts[0], out var minutes) && int.TryParse(parts[1], out var secs))
        {
            return (minutes * 60) + secs;
        }
        return 60;
    }

    private async Task SyncDisplayAssignmentsAsync()
    {
        if (hubConnection == null)
        {
            return;
        }

        var showSessionCode = BuildShowSessionCode();
        var assignedPairingCodes = new HashSet<string>(
            showConfig.DisplayAssignments
                .Where(assignment => !string.IsNullOrWhiteSpace(assignment.PairingCode))
                .Select(assignment => assignment.PairingCode),
            StringComparer.OrdinalIgnoreCase);

        var showRoles = new HashSet<string>(TalentShowShowDisplayRole.All, StringComparer.OrdinalIgnoreCase);
        foreach (var connected in connectedDevices.Where(device =>
                     showRoles.Contains(device.AssignedDisplayRole) &&
                     device.AssignedSessionCode.Equals(showSessionCode, StringComparison.OrdinalIgnoreCase) &&
                     !assignedPairingCodes.Contains(device.PairingCode)))
        {
            await hubConnection.InvokeAsync("RemoveDeviceAssignment", connected.PairingCode);
        }

        foreach (var assignment in showConfig.DisplayAssignments.Where(assignment => !string.IsNullOrWhiteSpace(assignment.PairingCode)))
        {
            await hubConnection.InvokeAsync("AssignDeviceToSession", assignment.PairingCode, showSessionCode, assignment.Role);
        }
    }

    private string BuildShowSessionCode()
    {
        var raw = $"SHOW-{EventId}";
        var normalized = new string(raw.ToUpperInvariant().Where(char.IsLetterOrDigit).ToArray());
        return string.IsNullOrWhiteSpace(normalized) ? $"SHOW{EventId}" : normalized;
    }

    private async Task SaveActAsync()
    {
        errorMessage = string.Empty;
        var payload = new TalentShowActUpsertDTO
        {
            PerformerName = editingAct.PerformerName,
            Title = editingAct.Title,
            Category = editingAct.Category,
            DurationSeconds = string.IsNullOrWhiteSpace(actDurationText) ? 180 : MmSsToSeconds(actDurationText),
            OrderIndex = editingAct.OrderIndex <= 0 ? acts.Count + 1 : editingAct.OrderIndex,
            IntroLine = editingAct.IntroLine,
            OutroLine = editingAct.OutroLine,
            MediaFilePath = editingAct.MediaFilePath,
            Notes = editingAct.Notes,
            SelectedForShow = true,
            MusicUrl = editingAct.MusicUrl,
            MusicStartOffsetSeconds = string.IsNullOrWhiteSpace(musicOffsetText) ? 0 : MmSsToSeconds(musicOffsetText),
            PerformerNotes = editingAct.PerformerNotes,
            StageNotes = editingAct.StageNotes,
            LightingNotes = editingAct.LightingNotes,
            SoundNotes = editingAct.SoundNotes,
            PropsRequired = editingAct.PropsRequired,
            HostIntro = editingAct.HostIntro
        };

        HttpResponseMessage response;
        if (editingAct.Id == 0)
        {
            response = await Http.PostAsJsonAsync($"/api/talentshow/{EventId}/acts", payload);
        }
        else
        {
            response = await Http.PutAsJsonAsync($"/api/talentshow/{EventId}/acts/{editingAct.Id}", payload);
        }

        if (!response.IsSuccessStatusCode)
        {
            errorMessage = "Failed to save act.";
            return;
        }

        ResetActForm();
        await LoadAsync();
    }

    private void EditAct(TalentShowAct act)
    {
        editingAct = new TalentShowAct
        {
            Id = act.Id,
            PerformerName = act.PerformerName,
            Title = act.Title,
            Category = act.Category,
            DurationSeconds = act.DurationSeconds,
            OrderIndex = act.OrderIndex,
            IntroLine = act.IntroLine,
            OutroLine = act.OutroLine,
            MediaFilePath = act.MediaFilePath,
            Notes = act.Notes,
            SelectedForShow = act.SelectedForShow,
            MusicUrl = act.MusicUrl,
            MusicStartOffsetSeconds = act.MusicStartOffsetSeconds,
            PerformerNotes = act.PerformerNotes,
            StageNotes = act.StageNotes,
            LightingNotes = act.LightingNotes,
            SoundNotes = act.SoundNotes,
            PropsRequired = act.PropsRequired,
            HostIntro = act.HostIntro
        };
        actDurationText = SecondsToMmSs(act.DurationSeconds);
        musicOffsetText = SecondsToMmSs(act.MusicStartOffsetSeconds);
    }

    private void ResetActForm()
    {
        editingAct = new TalentShowAct { DurationSeconds = 180, OrderIndex = acts.Count + 1, SelectedForShow = true };
        actDurationText = string.Empty;
        musicOffsetText = string.Empty;
    }

    private async Task DeleteActAsync(int actId)
    {
        var response = await Http.DeleteAsync($"/api/talentshow/{EventId}/acts/{actId}");
        if (!response.IsSuccessStatusCode)
        {
            errorMessage = "Failed to delete act.";
            return;
        }
        await LoadAsync();
    }

    private void AddSegment()
    {
        var segmentId = showConfig.Segments.Select(s => s.SegmentId).DefaultIfEmpty(0).Max() + 1;
        showConfig.Segments.Add(new TalentShowSegmentDTO
        {
            SegmentId = segmentId,
            SegmentType = string.IsNullOrWhiteSpace(newSegment.SegmentType) ? TalentShowSegmentType.HostTalk : newSegment.SegmentType,
            Title = string.IsNullOrWhiteSpace(newSegment.Title) ? "New Segment" : newSegment.Title.Trim(),
            HostText = newSegment.HostText?.Trim() ?? string.Empty,
            IntroText = newSegment.IntroText?.Trim() ?? string.Empty,
            Notes = newSegment.Notes?.Trim() ?? string.Empty,
            ExpectedDurationSeconds = newSegment.ExpectedDurationSeconds <= 0 ? 180 : newSegment.ExpectedDurationSeconds,
            OrderIndex = showConfig.Segments.Count + 1,
            Status = TalentShowSegmentStatus.Waiting
        });
        newSegment = new TalentShowSegmentDTO { SegmentType = TalentShowSegmentType.HostTalk, ExpectedDurationSeconds = 180 };
    }

    private void RemoveSegment(int segmentId)
    {
        showConfig.Segments = showConfig.Segments.Where(segment => segment.SegmentId != segmentId).ToList();
        for (var i = 0; i < showConfig.Segments.Count; i++)
        {
            showConfig.Segments[i].OrderIndex = i + 1;
        }
    }

    private List<TalentShowAct> GetUnusedActs()
    {
        var usedActIds = new HashSet<int>(
            showConfig.Segments
                .Where(s => s.SegmentType == TalentShowSegmentType.Act && s.ActId.HasValue)
                .Select(s => s.ActId.Value)
        );

        if (editingSegment.SegmentId != 0 && editingSegment.ActId.HasValue)
        {
            usedActIds.Remove(editingSegment.ActId.Value);
        }

        return acts.Where(a => !usedActIds.Contains(a.Id)).OrderBy(a => a.OrderIndex).ToList();
    }

    private async Task SaveSegmentAsync()
    {
        errorMessage = string.Empty;
        
        var duration = string.IsNullOrWhiteSpace(segmentDurationText) ? 180 : MmSsToSeconds(segmentDurationText);

        if (editingSegment.SegmentId == 0)
        {
            var segmentId = showConfig.Segments.Select(s => s.SegmentId).DefaultIfEmpty(0).Max() + 1;
            var newSegmentObj = new TalentShowSegmentDTO
            {
                SegmentId = segmentId,
                SegmentType = editingSegment.SegmentType,
                ActId = editingSegment.SegmentType == TalentShowSegmentType.Act ? editingSegment.ActId : null,
                Title = editingSegment.SegmentType == TalentShowSegmentType.Act 
                    ? (acts.FirstOrDefault(a => a.Id == editingSegment.ActId)?.Title ?? "Act")
                    : editingSegment.Title,
                IntroText = editingSegment.IntroText?.Trim() ?? string.Empty,
                HostText = editingSegment.HostText?.Trim() ?? string.Empty,
                Notes = editingSegment.Notes?.Trim() ?? string.Empty,
                ExpectedDurationSeconds = duration > 0 ? duration : 180,
                OrderIndex = showConfig.Segments.Count + 1,
                Status = TalentShowSegmentStatus.Waiting
            };
            showConfig.Segments.Add(newSegmentObj);
        }
        else
        {
            var existing = showConfig.Segments.FirstOrDefault(s => s.SegmentId == editingSegment.SegmentId);
            if (existing != null)
            {
                existing.SegmentType = editingSegment.SegmentType;
                existing.ActId = editingSegment.SegmentType == TalentShowSegmentType.Act ? editingSegment.ActId : null;
                existing.Title = editingSegment.SegmentType == TalentShowSegmentType.Act
                    ? (acts.FirstOrDefault(a => a.Id == editingSegment.ActId)?.Title ?? "Act")
                    : editingSegment.Title;
                existing.IntroText = editingSegment.IntroText?.Trim() ?? string.Empty;
                existing.HostText = editingSegment.HostText?.Trim() ?? string.Empty;
                existing.Notes = editingSegment.Notes?.Trim() ?? string.Empty;
                existing.ExpectedDurationSeconds = duration > 0 ? duration : 180;
                existing.OrderIndex = editingSegment.OrderIndex;
            }
        }

        ResetSegmentForm();
        await Task.CompletedTask;
    }

    private void EditSegment(TalentShowSegmentDTO segment)
    {
        editingSegment = new TalentShowSegmentDTO
        {
            SegmentId = segment.SegmentId,
            SegmentType = segment.SegmentType,
            ActId = segment.ActId,
            Title = segment.Title,
            IntroText = segment.IntroText,
            HostText = segment.HostText,
            Notes = segment.Notes,
            ExpectedDurationSeconds = segment.ExpectedDurationSeconds,
            OrderIndex = segment.OrderIndex,
            Status = segment.Status
        };
        segmentDurationText = SecondsToMmSs(segment.ExpectedDurationSeconds);
        showHostInsertMenu = false;
        showPerformerInsertMenu = false;
    }

    private void ResetSegmentForm()
    {
        editingSegment = new TalentShowSegmentDTO { SegmentType = TalentShowSegmentType.HostTalk, ExpectedDurationSeconds = 180 };
        segmentDurationText = string.Empty;
        showHostInsertMenu = false;
        showPerformerInsertMenu = false;
    }

    private async Task DeleteSegmentAsync(int segmentId)
    {
        RemoveSegment(segmentId);
        await Task.CompletedTask;
    }

    private void ShowHostNameInsertMenu()
    {
        showHostInsertMenu = !showHostInsertMenu;
    }

    private void ShowPerformerInsertMenu()
    {
        showPerformerInsertMenu = !showPerformerInsertMenu;
    }

    private void InsertHostName(string hostName)
    {
        var currentFocus = "hostText";
        if (editingSegment.HostText == null)
        {
            editingSegment.HostText = $"{hostName}: ";
        }
        else
        {
            editingSegment.HostText += $"{hostName}: ";
        }
        showHostInsertMenu = false;
    }

    private void InsertPerformerName(string performerName)
    {
        if (editingSegment.HostText == null)
        {
            editingSegment.HostText = performerName;
        }
        else
        {
            editingSegment.HostText += performerName;
        }
        showPerformerInsertMenu = false;
    }

    private TalentShowDisplayRoleAssignmentDTO? GetDisplayAssignment(string role)
        => showConfig.DisplayAssignments.FirstOrDefault(assignment => assignment.Role.Equals(role, StringComparison.OrdinalIgnoreCase));

    private TalentShowDisplayRoleAssignmentDTO? GetDisplayAssignmentByPairingCode(string pairingCode)
        => showConfig.DisplayAssignments.FirstOrDefault(assignment => assignment.PairingCode.Equals(pairingCode, StringComparison.OrdinalIgnoreCase));

    private void PreviewDisplay(string pairingCode)
    {
        var assignment = GetDisplayAssignmentByPairingCode(pairingCode);
        if (assignment != null)
        {
            Navigation.NavigateTo($"/display?code={pairingCode}");
        }
    }

    private void SetDisplayAssignment(string role, string? pairingCode)
    {
        var existing = GetDisplayAssignment(role);
        if (string.IsNullOrWhiteSpace(pairingCode))
        {
            if (existing != null)
            {
                showConfig.DisplayAssignments.Remove(existing);
            }
            return;
        }

        var device = connectedDevices.FirstOrDefault(d => d.PairingCode.Equals(pairingCode, StringComparison.OrdinalIgnoreCase));
        if (device == null)
        {
            return;
        }

        if (existing == null)
        {
            showConfig.DisplayAssignments.Add(new TalentShowDisplayRoleAssignmentDTO
            {
                Role = role,
                PairingCode = device.PairingCode,
                DisplayName = device.DisplayName
            });
            return;
        }

        existing.PairingCode = device.PairingCode;
        existing.DisplayName = device.DisplayName;
    }

    private async Task EnsureHubConnectionAsync()
    {
        if (hubConnection != null)
        {
            return;
        }

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/talent-show"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<List<TalentShowConnectedDevice>>("DeviceRegistryUpdated", devices =>
        {
            connectedDevices = devices ?? [];
            InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
        isHubConnected = hubConnection.State == HubConnectionState.Connected;
        await hubConnection.InvokeAsync("SubscribeController");
        connectedDevices = await hubConnection.InvokeAsync<List<TalentShowConnectedDevice>>("GetDeviceRegistry") ?? [];
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
