@using LuxfordPTAWeb.Shared.DTOs
@using LuxfordPTAWeb.Shared.Models
@using Microsoft.AspNetCore.SignalR.Client
@inject HttpClient Http
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="text-primary mb-0"><i class="bi bi-sliders"></i> Show Config Workspace</h6>
        <a class="btn btn-outline-secondary btn-sm" href="@($"/admin/eventcontrols/talent-show-director/{EventId}/tools/show/live")">Go to Live</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (isLoading)
    {
        <div class="alert alert-info"><em>Loading show config...</em></div>
    }
    else
    {
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item"><button class="nav-link @(activeTab == "status" ? "active" : string.Empty)" @onclick='() => activeTab = "status"'>Status</button></li>
            <li class="nav-item"><button class="nav-link @(activeTab == "settings" ? "active" : string.Empty)" @onclick='() => activeTab = "settings"'>Show Settings</button></li>
            <li class="nav-item"><button class="nav-link @(activeTab == "acts" ? "active" : string.Empty)" @onclick='() => activeTab = "acts"'>Acts</button></li>
            <li class="nav-item"><button class="nav-link @(activeTab == "timeline" ? "active" : string.Empty)" @onclick='() => activeTab = "timeline"'>Script / Timeline</button></li>
            <li class="nav-item"><button class="nav-link @(activeTab == "displays" ? "active" : string.Empty)" @onclick='() => activeTab = "displays"'>Displays</button></li>
        </ul>

        @if (activeTab == "status")
        {
            <div class="card mb-3">
                <div class="card-header fw-semibold">Config Status</div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Config Status (editable)</label>
                            <select class="form-select" @bind="showConfig.ConfigStatus">
                                @foreach (var status in TalentShowConfigStatus.All)
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Live Status (read-only)</label>
                            <input class="form-control" value="@showConfig.LiveStatus" readonly />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-semibold">Readiness Validation</div>
                <div class="card-body">
                    @if (showConfig.ReadinessValidation.IsReadySuggested)
                    {
                        <div class="text-success fw-semibold">Validation passed. Ready is suggested.</div>
                    }
                    else
                    {
                        <div class="text-warning fw-semibold mb-2">Validation items to review:</div>
                        <ul class="mb-0">
                            @foreach (var error in showConfig.ReadinessValidation.Errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header fw-semibold">Status Summary</div>
                <div class="card-body">
                    <div><strong>Judges Voting:</strong> @(showConfig.ShowSettings.JudgesVotingEnabled ? "Enabled" : "Disabled")</div>
                    <div><strong>Audience Voting:</strong> @(showConfig.ShowSettings.AudienceVotingEnabled ? "Enabled" : "Disabled")</div>
                    <div><strong>Host Names:</strong> @string.Join(", ", showConfig.ShowSettings.HostNames)</div>
                    <div><strong>Scoring Categories:</strong> @string.Join(", ", showConfig.ShowSettings.ScoringCategories)</div>
                    <div><strong>Scoring Scale:</strong> @showConfig.ShowSettings.ScoringScale</div>
                </div>
            </div>
        }
        else if (activeTab == "settings")
        {
            <div class="card mb-3">
                <div class="card-header fw-semibold">Global Settings</div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Show Start Time Override</label>
                            <input type="datetime-local" class="form-control" @bind="showConfig.ShowStartTimeOverride" />
                            <small class="text-muted">Optional. Overrides the Event Schedule start time for countdowns and messaging.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Show Theme</label>
                            <input class="form-control" @bind="showConfig.ShowSettings.ShowTheme" placeholder="e.g., 'Dark', 'Rainbow', 'Neon'" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Show Background Image URL</label>
                            <input class="form-control" @bind="showConfig.ShowSettings.ShowBackgroundImageUrl" placeholder="https://..." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Default Segment Duration (mm:ss)</label>
                            <input class="form-control" @bind="defaultSegmentDurationText" placeholder="mm:ss" />
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" @bind="showConfig.ShowSettings.EnableSponsorRotation" />
                                <label class="form-check-label">Enable Sponsor Rotation</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-semibold">Host Names</div>
                <div class="card-body">
                    <label class="form-label">Host Name(s) (one per line) — Required</label>
                    <textarea class="form-control" rows="3" @bind="hostNamesText"></textarea>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-semibold">Voting Options</div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" @bind="showConfig.ShowSettings.JudgesVotingEnabled" />
                                <label class="form-check-label">Judges Voting</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" @bind="showConfig.ShowSettings.AudienceVotingEnabled" />
                                <label class="form-check-label">Audience Voting</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (showConfig.ShowSettings.JudgesVotingEnabled || showConfig.ShowSettings.AudienceVotingEnabled)
            {
                <div class="card mb-3">
                    <div class="card-header fw-semibold">Scoring Scale</div>
                    <div class="card-body">
                        <label class="form-label">Maximum Score</label>
                        <input type="number" min="1" max="100" class="form-control" @bind="showConfig.ShowSettings.ScoringScale" />
                    </div>
                </div>

                <div class="card">
                    <div class="card-header fw-semibold">Scoring Categories</div>
                    <div class="card-body">
                        <label class="form-label">Categories (one per line)</label>
                        <textarea class="form-control" rows="5" @bind="scoringCategoriesText"></textarea>
                        <small class="text-muted d-block mt-2">
                            If empty, will auto-populate with defaults:<br/>
                            • Stage Presence<br/>
                            • Creativity<br/>
                            • Technical Skill<br/>
                            • Entertainment Value<br/>
                            • Overall Impression
                        </small>
                    </div>
                </div>
            }
        }
        else if (activeTab == "acts")
        {
            <div class="card mb-3">
                <div class="card-header fw-semibold">Add/Edit Act</div>
                <div class="card-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Performer Name</label>
                            <input class="form-control" @bind="editingAct.PerformerName" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Act Title</label>
                            <input class="form-control" @bind="editingAct.Title" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Category</label>
                            <input class="form-control" @bind="editingAct.Category" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Duration (mm:ss)</label>
                            <input class="form-control" @bind="actDurationText" placeholder="mm:ss" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Order</label>
                            <input type="number" min="1" class="form-control" @bind="editingAct.OrderIndex" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Music URL</label>
                            <input class="form-control" @bind="editingAct.MusicUrl" placeholder="https://..." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Music Start Offset (mm:ss)</label>
                            <input class="form-control" @bind="musicOffsetText" placeholder="mm:ss" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Host Intro (for scripts)</label>
                            <input class="form-control" @bind="editingAct.HostIntro" placeholder="e.g., 'Please welcome...'" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Performer Notes</label>
                            <textarea class="form-control" rows="2" @bind="editingAct.PerformerNotes"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Stage Notes</label>
                            <textarea class="form-control" rows="2" @bind="editingAct.StageNotes"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Lighting Notes</label>
                            <textarea class="form-control" rows="2" @bind="editingAct.LightingNotes"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Sound Notes</label>
                            <textarea class="form-control" rows="2" @bind="editingAct.SoundNotes"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Props Required</label>
                            <textarea class="form-control" rows="2" @bind="editingAct.PropsRequired"></textarea>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">General Notes</label>
                            <textarea class="form-control" rows="2" @bind="editingAct.Notes"></textarea>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" @onclick="SaveActAsync">@(editingAct.Id == 0 ? "Add Act" : "Update Act")</button>
                        @if (editingAct.Id != 0)
                        {
                            <button class="btn btn-secondary" @onclick="ResetActForm">Cancel</button>
                        }
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Order</th><th>Performer</th><th>Act</th><th>Duration</th><th>Music</th><th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var act in acts.OrderBy(a => a.OrderIndex))
                                {
                                    <tr>
                                        <td>@act.OrderIndex</td>
                                        <td>@act.PerformerName</td>
                                        <td>@act.Title</td>
                                        <td>@SecondsToMmSs(act.DurationSeconds)</td>
                                        <td>@(string.IsNullOrWhiteSpace(act.MusicUrl) ? "—" : "✓")</td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => EditAct(act)">Edit</button>
                                                <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteActAsync(act.Id)">Delete</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else if (activeTab == "timeline")
        {
            <div class="card mb-3">
                <div class="card-header fw-semibold">@(editingSegment.SegmentId == 0 ? "Add Segment" : "Edit Segment")</div>
                <div class="card-body">
                    <div class="row g-2 mb-2">
                        <div class="col-md-2">
                            <label class="form-label">Type</label>
                            <select class="form-select" @bind="editingSegment.SegmentType">
                                @foreach (var type in TalentShowSegmentType.All)
                                {
                                    <option value="@type">@type</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            @if (editingSegment.SegmentType == TalentShowSegmentType.Act)
                            {
                                <label class="form-label">Select Act</label>
                                <select class="form-select" @bind="editingSegment.ActId">
                                    <option value="">-- Select Act --</option>
                                    @foreach (var act in GetUnusedActs())
                                    {
                                        var selected = editingSegment.ActId == act.Id;
                                        <option value="@act.Id" selected="@selected">@act.PerformerName - @act.Title</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <label class="form-label">Segment Name</label>
                                <input class="form-control" @bind="editingSegment.Title" />
                            }
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Duration (mm:ss)</label>
                            <input class="form-control" @bind="segmentDurationText" placeholder="mm:ss" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Order</label>
                            <input type="number" min="1" class="form-control" @bind="editingSegment.OrderIndex" />
                        </div>
                    </div>
                    
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label">Intro Text</label>
                            <div class="d-flex gap-2 align-items-end">
                                <div class="flex-grow-1">
                                    <textarea class="form-control" rows="3" @bind="editingSegment.IntroText"></textarea>
                                </div>
                                <div>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="ShowHostNameInsertMenu" title="Insert host name as literal text">
                                        Insert Host
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Host Text / Script</label>
                            <div class="d-flex gap-2 align-items-end">
                                <div class="flex-grow-1">
                                    <textarea class="form-control" rows="3" @bind="editingSegment.HostText"></textarea>
                                </div>
                                <div class="d-flex flex-column gap-1">
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="ShowHostNameInsertMenu" title="Insert host name as literal text">
                                        Host
                                    </button>
                                    @if (editingSegment.SegmentType == TalentShowSegmentType.Act)
                                    {
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="ShowPerformerInsertMenu" title="Insert performer name as literal text">
                                            Performer
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (showHostInsertMenu)
                    {
                        <div class="row g-2 mb-2">
                            <div class="col-md-12">
                                <div class="border p-2 rounded bg-light">
                                    <strong>Select Host Name to Insert:</strong>
                                    <div class="d-flex gap-2 flex-wrap mt-2">
                                        @foreach (var hostName in showConfig.ShowSettings.HostNames)
                                        {
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => InsertHostName(hostName)">
                                                @hostName:
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (showPerformerInsertMenu && editingSegment.SegmentType == TalentShowSegmentType.Act && editingSegment.ActId.HasValue)
                    {
                        var selectedAct = acts.FirstOrDefault(a => a.Id == editingSegment.ActId);
                        @if (selectedAct != null)
                        {
                            <div class="row g-2 mb-2">
                                <div class="col-md-12">
                                    <div class="border p-2 rounded bg-light">
                                        <strong>Selected performers:</strong>
                                        <div class="d-flex gap-2 flex-wrap mt-2">
                                            <button class="btn btn-sm btn-outline-info" @onclick="() => InsertPerformerName(selectedAct.PerformerName)">
                                                @selectedAct.PerformerName
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    <div class="row g-2 mb-3">
                        <div class="col-md-12">
                            <label class="form-label">Notes</label>
                            <textarea class="form-control" rows="2" @bind="editingSegment.Notes"></textarea>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" @onclick="SaveSegmentAsync">@(editingSegment.SegmentId == 0 ? "Add Segment" : "Update Segment")</button>
                        @if (editingSegment.SegmentId != 0)
                        {
                            <button class="btn btn-secondary" @onclick="ResetSegmentForm">Cancel</button>
                        }
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header fw-semibold">Timeline</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>#</th><th>Type</th><th>Name</th><th>Performers</th><th>Duration</th><th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var segment in showConfig.Segments.OrderBy(s => s.OrderIndex))
                                {
                                    var segmentAct = segment.ActId.HasValue ? acts.FirstOrDefault(a => a.Id == segment.ActId.Value) : null;
                                    <tr>
                                        <td>@segment.OrderIndex</td>
                                        <td>
                                            @if (segment.SegmentType == TalentShowSegmentType.Act) { <span title="Act">🎭</span> }
                                            else if (segment.SegmentType == TalentShowSegmentType.HostTalk) { <span title="Host Talk">🎤</span> }
                                            else if (segment.SegmentType == TalentShowSegmentType.Intermission) { <span title="Intermission">⏸</span> }
                                            else if (segment.SegmentType == TalentShowSegmentType.Awards) { <span title="Awards">🏆</span> }
                                            else { <text>@segment.SegmentType</text> }
                                        </td>
                                        <td>@(segmentAct?.Title ?? segment.Title)</td>
                                        <td>@(segmentAct?.PerformerName ?? "—")</td>
                                        <td>@SecondsToMmSs(segment.ExpectedDurationSeconds)</td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => EditSegment(segment)">Edit</button>
                                                <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteSegmentAsync(segment.SegmentId)">Delete</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card mb-3">
                <div class="card-header fw-semibold">Display Roles</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div>
                                <strong>📺 MainDisplay</strong>
                                <p class="text-muted small">Audience-facing main screen. Shows welcome, sponsors, act cards, timing, scoring results.</p>
                            </div>
                            <div>
                                <strong>🎭 BackstagePrompt</strong>
                                <p class="text-muted small">Backstage cue display. Shows current performer, timing, next up, and stage notes.</p>
                            </div>
                            <div>
                                <strong>🎬 FrontstagePrompt</strong>
                                <p class="text-muted small">Frontstage cue display. Shows performer name, duration, and audience-facing prompts.</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div>
                                <strong>🎤 HostPrompt</strong>
                                <p class="text-muted small">Host teleprompter. Scrollable script with timing, ad-libs, and introductions.</p>
                            </div>
                            <div>
                                <strong>⭐ Judges</strong>
                                <p class="text-muted small">Judge scoring interface. Shows scoring form (during Act segments only) when voting enabled.</p>
                            </div>
                            <div>
                                <strong>👥 Voters</strong>
                                <p class="text-muted small">Audience voting interface. Shows voting cards when audience voting enabled during Acts.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Connected Displays</span>
                    <span class="badge @(isHubConnected ? "bg-success" : "bg-secondary")">@(isHubConnected ? "Hub Connected" : "Hub Disconnected")</span>
                </div>
                <div class="card-body p-0">
                    @if (connectedDevices.Count == 0)
                    {
                        <div class="p-3 text-muted">No displays currently connected. Open /display on devices to pair.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Display Name</th><th>Role</th><th>Status</th><th>Pairing Code</th><th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var device in connectedDevices.OrderBy(d => d.DisplayName))
                                    {
                                        var assignment = GetDisplayAssignmentByPairingCode(device.PairingCode);
                                        <tr>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" @bind="device.DisplayName" placeholder="Display name" />
                                            </td>
                                            <td>
                                                <select class="form-select form-select-sm" @onchange="e => SetDisplayAssignment(e.Value?.ToString() ?? string.Empty, device.PairingCode)">
                                                    <option value="">-- Unassigned --</option>
                                                    @foreach (var role in TalentShowShowDisplayRole.All)
                                                    {
                                                        var selected = assignment?.Role == role;
                                                        <option value="@role" selected="@selected">@role</option>
                                                    }
                                                </select>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">Connected</span>
                                            </td>
                                            <td>
                                                <code>@device.PairingCode</code>
                                            </td>
                                            <td>
                                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => PreviewDisplay(device.PairingCode)" title="Preview this display">
                                                    Preview
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header fw-semibold">Example Display Layouts (Setup Mode)</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6 col-lg-4">
                            <div class="border rounded p-3 bg-light" style="min-height: 300px;">
                                <h6 class="mb-2">📺 MainDisplay</h6>
                                <div style="background: #222; color: white; padding: 15px; text-align: center; margin: 10px 0;">
                                    <div style="font-size: 24px; font-weight: bold;">Welcome to the Talent Show!</div>
                                    <div style="margin-top: 20px; font-size: 14px;">
                                        <div>🎭 Act 1: Sarah - Contemporary Dance</div>
                                        <div style="margin-top: 10px; color: #888;">Sponsor Rotation Placeholder</div>
                                    </div>
                                </div>
                                <small class="text-muted d-block mt-2">Shows welcome, sponsors, and current act info</small>
                            </div>
                        </div>

                        <div class="col-md-6 col-lg-4">
                            <div class="border rounded p-3 bg-light" style="min-height: 300px;">
                                <h6 class="mb-2">🎭 BackstagePrompt</h6>
                                <div style="background: #1a1a1a; color: #0f0; padding: 15px; font-family: monospace; margin: 10px 0;">
                                    <div><strong>NOW:</strong> Sarah - Contemporary Dance</div>
                                    <div style="margin-top: 10px; color: #888;">Duration: 2:30</div>
                                    <div style="margin-top: 15px;"><strong>NEXT:</strong> Marcus - Comedy Skit</div>
                                    <div style="margin-top: 10px; color: #888;">Notes: Ready on mark</div>
                                </div>
