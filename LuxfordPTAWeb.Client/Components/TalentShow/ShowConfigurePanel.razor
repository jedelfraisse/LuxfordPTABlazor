        }

        <div class="mt-3">
            <button class="btn btn-primary" @onclick="SaveShowConfigAsync" disabled="@isSaving">
                @if (isSaving) { <span>Saving...</span> } else { <span>Save Show Config</span> }
            </button>
        </div>
