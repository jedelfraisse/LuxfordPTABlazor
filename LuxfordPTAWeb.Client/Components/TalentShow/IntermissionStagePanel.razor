@using LuxfordPTAWeb.Shared.DTOs

<div>
    <h6 class="text-danger mb-3"><i class="bi bi-pause-circle"></i> Intermission Stage</h6>
    
    <p class="text-muted">Manage intermission break: countdown, sponsor display, and timing.</p>
    
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Intermission Duration (minutes)</label>
            <input type="number" class="form-control" @bind="intermissionMinutes" min="1" max="30" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Intermission Start Time</label>
            <input type="time" class="form-control" @bind="intermissionStart" />
        </div>

        <div class="col-12">
            <label class="form-label">Intermission Message</label>
            <textarea class="form-control" @bind="intermissionMessage" rows="3" placeholder="Display message during intermission (sponsors, upcoming events, etc.)"></textarea>
        </div>

        <div class="col-12">
            <label class="form-label">Intermission Activities</label>
            <div class="alert alert-info">
                <strong>Main Board Display:</strong> Shows intermission countdown and sponsor loop<br />
                <strong>Backstage:</strong> Cues performers for next act
            </div>
        </div>

        <div class="col-12">
            <label class="form-label">Notes</label>
            <textarea class="form-control" @bind="intermissionNotes" rows="3" placeholder="Intermission logistics notes..."></textarea>
        </div>
    </div>

    <div class="mt-3">
        <button class="btn btn-primary" @onclick="SaveIntermissionAsync" disabled="@isSaving">
            <i class="bi bi-check-circle"></i> Save Intermission
        </button>
        @if (!string.IsNullOrWhiteSpace(saveMessage))
        {
            <span class="ms-2 text-success">@saveMessage</span>
        }
    </div>
</div>

@code {
    [Parameter] public int EventId { get; set; }

    private int intermissionMinutes = 15;
    private TimeOnly intermissionStart = TimeOnly.FromDateTime(DateTime.Now);
    private string intermissionMessage = string.Empty;
    private string intermissionNotes = string.Empty;
    private bool isSaving;
    private string saveMessage = string.Empty;

    private async Task SaveIntermissionAsync()
    {
        isSaving = true;
        saveMessage = string.Empty;
        try
        {
            saveMessage = "Intermission settings saved successfully!";
            await Task.Delay(1500);
            saveMessage = string.Empty;
        }
        catch (Exception ex)
        {
            saveMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
