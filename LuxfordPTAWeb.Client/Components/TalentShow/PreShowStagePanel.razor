@using LuxfordPTAWeb.Shared.DTOs

<div>
    <h6 class="text-success mb-3"><i class="bi bi-play-circle"></i> Pre-Show Stage</h6>
    
    <p class="text-muted">Final preparations and lineup verification before the show starts.</p>
    
    <div class="row g-3">
        <div class="col-12">
            <label class="form-label">Pre-Show Checklist</label>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" @bind="checklistDisplaysPaired" id="displaysPaired" />
                <label class="form-check-label" for="displaysPaired">All displays paired and connected</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" @bind="checklistAudioVideoReady" id="audioVideoReady" />
                <label class="form-check-label" for="audioVideoReady">Audio/video systems tested</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" @bind="checklistJudgePanelReady" id="judgePanelReady" />
                <label class="form-check-label" for="judgePanelReady">Judge panel ready at tables</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" @bind="checklistLineupConfirmed" id="lineupConfirmed" />
                <label class="form-check-label" for="lineupConfirmed">Act lineup confirmed with performers</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" @bind="checklistBackstageStaffReady" id="backstageStaffReady" />
                <label class="form-check-label" for="backstageStaffReady">Backstage staff briefed</label>
            </div>
        </div>

        <div class="col-12">
            <label class="form-label">Show Start Time</label>
            <input type="time" class="form-control" @bind="showStartTime" />
        </div>

        <div class="col-12">
            <label class="form-label">Final Notes</label>
            <textarea class="form-control" @bind="preShowNotes" rows="4" placeholder="Last-minute reminders, special instructions..."></textarea>
        </div>
    </div>

    <div class="mt-3">
        <button class="btn btn-primary" @onclick="SavePreShowAsync" disabled="@isSaving">
            <i class="bi bi-check-circle"></i> Save Pre-Show Checklist
        </button>
        @if (!string.IsNullOrWhiteSpace(saveMessage))
        {
            <span class="ms-2 text-success">@saveMessage</span>
        }
    </div>
</div>

@code {
    [Parameter] public int EventId { get; set; }

    private bool checklistDisplaysPaired;
    private bool checklistAudioVideoReady;
    private bool checklistJudgePanelReady;
    private bool checklistLineupConfirmed;
    private bool checklistBackstageStaffReady;
    private TimeOnly showStartTime = TimeOnly.FromDateTime(DateTime.Now);
    private string preShowNotes = string.Empty;
    private bool isSaving;
    private string saveMessage = string.Empty;

    private async Task SavePreShowAsync()
    {
        isSaving = true;
        saveMessage = string.Empty;
        try
        {
            saveMessage = "Pre-Show checklist saved successfully!";
            await Task.Delay(1500);
            saveMessage = string.Empty;
        }
        catch (Exception ex)
        {
            saveMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
