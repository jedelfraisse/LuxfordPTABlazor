@using LuxfordPTAWeb.Shared.DTOs
@inject HttpClient Http

<div>
    <h6 class="text-dark mb-3"><i class="bi bi-globe2"></i> Global Setup Configuration</h6>
    <p class="text-muted">Set defaults and shared rules used across all Talent Show modules.</p>

    @if (isLoading)
    {
        <div class="alert alert-info"><em>Loading global setup configuration...</em></div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Event Title</label>
                <input type="text" class="form-control" @bind="settings.EventTitle" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Theme</label>
                <input type="text" class="form-control" @bind="settings.Theme" placeholder="e.g. Stars and Spotlight" />
            </div>

            <div class="col-12">
                <label class="form-label">Branding Message</label>
                <input type="text" class="form-control" @bind="settings.BrandingMessage" placeholder="Message shown across modules and public pages" />
            </div>

            <div class="col-12">
                <label class="form-label">Default Display Settings</label>
                <textarea class="form-control" rows="3" @bind="settings.DefaultDisplaySettings" placeholder="Default host/backstage/main board guidance..."></textarea>
            </div>

            <div class="col-md-6">
                <label class="form-label">Default Media Rules</label>
                <textarea class="form-control" rows="4" @bind="settings.DefaultMediaRules" placeholder="Accepted formats, duration limits, upload notes..."></textarea>
            </div>

            <div class="col-md-6">
                <label class="form-label">Default Cue Rules</label>
                <textarea class="form-control" rows="4" @bind="settings.DefaultCueRules" placeholder="Cue naming, timing, and required metadata..."></textarea>
            </div>

            <div class="col-12">
                <label class="form-label">Default Segment Behavior</label>
                <textarea class="form-control" rows="3" @bind="settings.DefaultSegmentBehavior" placeholder="Segment defaults for transitions, intros, and timing..."></textarea>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" @bind="settings.JudgesVotingEnabledByDefault" id="globalSetupJudgesVoting" />
                    <label class="form-check-label" for="globalSetupJudgesVoting">Enable judges voting by default</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" @bind="settings.AudienceVotingEnabledByDefault" id="globalSetupAudienceVoting" />
                    <label class="form-check-label" for="globalSetupAudienceVoting">Enable audience voting by default</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" @bind="settings.PublishGlobalInfo" id="globalSetupPublishInfo" />
                    <label class="form-check-label" for="globalSetupPublishInfo">Publish global setup info for public-facing use</label>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header"><strong>Planning Defaults (Fallbacks)</strong></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Default Max Acts</label>
                        <input type="number" class="form-control" min="1" @bind="settings.DefaultMaxActs" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Default Number of Judges</label>
                        <input type="number" class="form-control" min="1" @bind="settings.DefaultJudgeCount" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Default External Sign-Up URL</label>
                        <input type="url" class="form-control" @bind="settings.DefaultExternalSignupUrl" placeholder="https://example.com/signup" />
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="settings.DefaultMaxActsFlexible" id="globalDefaultMaxActsFlexible" />
                            <label class="form-check-label" for="globalDefaultMaxActsFlexible">Use flexible max acts range by default</label>
                        </div>
                    </div>

                    @if (settings.DefaultMaxActsFlexible)
                    {
                        <div class="col-md-6">
                            <label class="form-label">Default Max Acts Min</label>
                            <input type="number" class="form-control" min="1" @bind="settings.DefaultMaxActsMin" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Default Max Acts Max</label>
                            <input type="number" class="form-control" min="1" @bind="settings.DefaultMaxActsMax" />
                        </div>
                    }

                    <div class="col-md-6">
                        <label class="form-label">Default Sign-Up Start</label>
                        <input type="date" class="form-control" @bind-value="settings.DefaultSignupStart" @bind-value:format="yyyy-MM-dd" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Default Sign-Up End</label>
                        <input type="date" class="form-control" @bind-value="settings.DefaultSignupEnd" @bind-value:format="yyyy-MM-dd" />
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="settings.DefaultAutoClose" id="globalDefaultAutoClose" />
                            <label class="form-check-label" for="globalDefaultAutoClose">Default Auto-Close sign-ups</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Default Judge Names</label>
                        <textarea class="form-control" rows="3" @bind="defaultJudgeNamesText" placeholder="One judge name per line"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Default Categories</label>
                        <textarea class="form-control" rows="3" @bind="defaultCategoriesText" placeholder="Singing&#10;Dancing&#10;Comedy"></textarea>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label">Default Rules & Guidelines</label>
                        <textarea class="form-control" rows="4" @bind="settings.DefaultRulesMarkdown" placeholder="Enter fallback rules and guidelines..."></textarea>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Default Rules PDF Path</label>
                        <input type="text" class="form-control" @bind="settings.DefaultRulesPdfPath" placeholder="/files/talent-show-rules.pdf" />
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" @bind="settings.DefaultPublishRules" id="globalDefaultPublishRules" />
                            <label class="form-check-label" for="globalDefaultPublishRules">Publish rules by default</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <span><i class="bi bi-check-circle"></i> Save Global Setup</span>
                }
            </button>
            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <span class="ms-2 text-success">@successMessage</span>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int EventId { get; set; }

    private TalentShowGlobalSetupConfigDTO settings = new();
    private string defaultJudgeNamesText = string.Empty;
    private string defaultCategoriesText = string.Empty;
    private bool isLoading = true;
    private bool isSaving;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            settings = await Http.GetFromJsonAsync<TalentShowGlobalSetupConfigDTO>($"/api/talentshow/{EventId}/global/configure")
                ?? new TalentShowGlobalSetupConfigDTO();
            defaultJudgeNamesText = settings.DefaultJudgeNames.Any()
                ? string.Join('\n', settings.DefaultJudgeNames)
                : string.Empty;
            defaultCategoriesText = settings.DefaultCategories.Any()
                ? string.Join('\n', settings.DefaultCategories)
                : string.Empty;
        }
        catch (Exception ex)
        {
            settings = new TalentShowGlobalSetupConfigDTO();
            errorMessage = $"Error loading global setup configuration: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            settings.DefaultJudgeNames = defaultJudgeNamesText
                .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList();
            settings.DefaultCategories = defaultCategoriesText
                .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList();

            var response = await Http.PutAsJsonAsync($"/api/talentshow/{EventId}/global/configure", settings);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                errorMessage = string.IsNullOrWhiteSpace(body) ? "Failed to save global setup configuration." : body;
                return;
            }

            successMessage = "Global setup configuration saved.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving global setup configuration: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
