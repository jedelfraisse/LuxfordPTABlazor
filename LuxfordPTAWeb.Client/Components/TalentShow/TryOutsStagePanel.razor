@using LuxfordPTAWeb.Shared.DTOs

<div>
    <h6 class="text-warning mb-3"><i class="bi bi-people"></i> Try-Outs Stage</h6>
    
    <p class="text-muted">Review audition submissions, track attendance, and score performances.</p>
    
    <div class="row g-3">
        <div class="col-12">
            <div class="card bg-light">
                <div class="card-body">
                    <h6 class="card-title">Audition Workflow</h6>
                    <p class="card-text">Use the <strong>Talent Show Control</strong> in the main controls tab to:</p>
                    <ul class="mb-0">
                        <li>View submitted acts</li>
                        <li>Mark attendance</li>
                        <li>Record judge scores (1-5 per category)</li>
                        <li>Toggle "Selected for Show" flag</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-12">
            <label class="form-label">Audition Notes</label>
            <textarea class="form-control" @bind="auditionNotes" rows="5" placeholder="Add notes about the audition process..."></textarea>
        </div>

        <div class="col-md-6">
            <label class="form-label">Acts Currently Entered</label>
            <div class="input-group">
                <input type="number" class="form-control" value="@actCount" disabled />
                <span class="input-group-text">acts</span>
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label">Acts Selected for Show</label>
            <div class="input-group">
                <input type="number" class="form-control" value="@selectedActCount" disabled />
                <span class="input-group-text">acts</span>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button class="btn btn-primary" @onclick="SaveTryOutsAsync" disabled="@isSaving">
            <i class="bi bi-check-circle"></i> Save Try-Outs Notes
        </button>
        @if (!string.IsNullOrWhiteSpace(saveMessage))
        {
            <span class="ms-2 text-success">@saveMessage</span>
        }
    </div>
</div>

@code {
    [Parameter] public int EventId { get; set; }

    private string auditionNotes = string.Empty;
    private int actCount = 0;
    private int selectedActCount = 0;
    private bool isSaving;
    private string saveMessage = string.Empty;

    private async Task SaveTryOutsAsync()
    {
        isSaving = true;
        saveMessage = string.Empty;
        try
        {
            saveMessage = "Try-Outs notes saved successfully!";
            await Task.Delay(1500);
            saveMessage = string.Empty;
        }
        catch (Exception ex)
        {
            saveMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
