@using LuxfordPTAWeb.Shared.Models
@using LuxfordPTAWeb.Shared.DTOs
@inject HttpClient Http

<div>
    <h6 class="text-primary mb-3"><i class="bi bi-clipboard-check"></i> Planning Stage</h6>
    
    <p class="text-muted">Set up the talent show basics: max acts, tryout details, and signup information.</p>
    
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Maximum Acts</label>
            <input type="number" class="form-control" @bind="maxActs" placeholder="e.g., 25" min="1" />
            <small class="text-muted">Maximum number of acts to accept during tryouts</small>
        </div>

        <div class="col-md-6">
            <label class="form-label">Number of Judges</label>
            <input type="number" class="form-control" @bind="judgeCount" placeholder="e.g., 3" min="1" />
            <small class="text-muted">Number of judges who will score acts</small>
        </div>

        <div class="col-12">
            <label class="form-label">Signup Form Link</label>
            <input type="url" class="form-control" @bind="signupFormLink" placeholder="https://docs.google.com/forms/..." />
            <small class="text-muted">URL for performers to submit acts</small>
        </div>

        <div class="col-md-6">
            <label class="form-label">Try-Outs Start Date</label>
            <input type="date" class="form-control" @bind="tryOutsStartDate" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Try-Outs End Date</label>
            <input type="date" class="form-control" @bind="tryOutsEndDate" />
        </div>

        <div class="col-12">
            <label class="form-label">Categories</label>
            <textarea class="form-control" @bind="categoriesText" rows="3" placeholder="Singing&#10;Dancing&#10;Comedy&#10;Instrumental&#10;Other"></textarea>
            <small class="text-muted">One category per line</small>
        </div>

        <div class="col-12">
            <label class="form-label">Rules & Guidelines</label>
            <textarea class="form-control" @bind="rulesText" rows="4" placeholder="Enter show rules..."></textarea>
        </div>
    </div>

    <div class="mt-3">
        <button class="btn btn-primary" @onclick="SavePlanningAsync" disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Saving...</span>
            }
            else
            {
                <span><i class="bi bi-check-circle"></i> Save Planning Stage</span>
            }
        </button>
        @if (!string.IsNullOrWhiteSpace(saveMessage))
        {
            <span class="ms-2 text-success">@saveMessage</span>
        }
    </div>
</div>

@code {
    [Parameter] public int EventId { get; set; }

    private int maxActs = 25;
    private int judgeCount = 3;
    private string signupFormLink = string.Empty;
    private DateTime tryOutsStartDate = DateTime.Today;
    private DateTime tryOutsEndDate = DateTime.Today.AddDays(7);
    private string categoriesText = "Singing\nDancing\nComedy\nInstrumental\nOther";
    private string rulesText = string.Empty;
    private bool isSaving;
    private string saveMessage = string.Empty;

    private async Task SavePlanningAsync()
    {
        isSaving = true;
        saveMessage = string.Empty;
        try
        {
            // TODO: Save planning data to API or event metadata
            saveMessage = "Planning stage saved successfully!";
            await Task.Delay(1500);
            saveMessage = string.Empty;
        }
        catch (Exception ex)
        {
            saveMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
