@using LuxfordPTAWeb.Shared.DTOs

<div>
    <h6 class="text-danger mb-3"><i class="bi bi-camera-video"></i> Host Talk Stage</h6>
    
    <p class="text-muted">Host script and cues for host address segments during the show.</p>
    
    <div class="row g-3">
        <div class="col-12">
            <label class="form-label">Host Script</label>
            <textarea class="form-control" @bind="hostScript" rows="8" placeholder="Enter host talking points and introductions..."></textarea>
        </div>

        <div class="col-12">
            <label class="form-label">Upcoming Act Preview</label>
            <div class="alert alert-info">
                When transitioning to Host Talk, the current act will be shown to the audience.
                Use this stage to script the introduction and build anticipation.
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label">Estimated Duration (minutes)</label>
            <input type="number" class="form-control" @bind="estimatedMinutes" min="1" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Transition Notes</label>
            <input type="text" class="form-control" @bind="transitionNotes" placeholder="e.g., Recognize sponsors, announce next act..." />
        </div>
    </div>

    <div class="mt-3">
        <button class="btn btn-primary" @onclick="SaveHostTalkAsync" disabled="@isSaving">
            <i class="bi bi-check-circle"></i> Save Host Talk
        </button>
        @if (!string.IsNullOrWhiteSpace(saveMessage))
        {
            <span class="ms-2 text-success">@saveMessage</span>
        }
    </div>
</div>

@code {
    [Parameter] public int EventId { get; set; }

    private string hostScript = string.Empty;
    private int estimatedMinutes = 2;
    private string transitionNotes = string.Empty;
    private bool isSaving;
    private string saveMessage = string.Empty;

    private async Task SaveHostTalkAsync()
    {
        isSaving = true;
        saveMessage = string.Empty;
        try
        {
            saveMessage = "Host Talk saved successfully!";
            await Task.Delay(1500);
            saveMessage = string.Empty;
        }
        catch (Exception ex)
        {
            saveMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
