@using LuxfordPTAWeb.Shared.DTOs
@inject HttpClient Http

<div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="text-primary mb-0"><i class="bi bi-pencil-square"></i> Sign-Up Configuration</h6>
        <a class="btn btn-outline-secondary btn-sm" href="@($"/admin/eventcontrols/talent-show-director/{EventId}/tools/signups/review")">Go to Review</a>
    </div>
    <p class="text-muted">Configure sign-up window and public page metadata. Try-out decisions are made per submission in Run.</p>

    @if (isLoading)
    {
        <div class="alert alert-info"><em>Loading sign-up settings...</em></div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Sign-Up Start</label>
                <input type="date" class="form-control" @bind-value="settings.SignupStart" @bind-value:format="yyyy-MM-dd" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Sign-Up End</label>
                <input type="date" class="form-control" @bind-value="settings.SignupEnd" @bind-value:format="yyyy-MM-dd" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Public URL</label>
                <input type="text" class="form-control" @bind="settings.PublicUrl" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Page Title</label>
                <input type="text" class="form-control" @bind="settings.Title" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Page Subtitle</label>
                <input type="text" class="form-control" @bind="settings.Subtitle" />
            </div>

            <div class="col-12">
                <label class="form-label">Confirmation Message</label>
                <textarea class="form-control" rows="3" @bind="settings.ConfirmationMessage"></textarea>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" @bind="settings.AutoClose" id="signupAutoClose" />
                    <label class="form-check-label" for="signupAutoClose">Auto-close at end date</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" @bind="settings.ShowCountdown" id="signupShowCountdown" />
                    <label class="form-check-label" for="signupShowCountdown">Show countdown</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" @bind="settings.IsPublished" id="signupPublished" />
                    <label class="form-check-label" for="signupPublished">Published</label>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <span><i class="bi bi-check-circle"></i> Save Sign-Up Configuration</span>
                }
            </button>
            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <span class="ms-2 text-success">@successMessage</span>
            }
        </div>

        <div class="card mt-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Sign-Up Page Preview</strong>
                @if (!string.IsNullOrWhiteSpace(settings.PublicUrl))
                {
                    <a class="btn btn-outline-secondary btn-sm" href="@settings.PublicUrl" target="_blank" rel="noopener noreferrer">Open URL</a>
                }
            </div>
            <div class="card-body">
                <h5 class="mb-1">@(!string.IsNullOrWhiteSpace(settings.Title) ? settings.Title : "Talent Show Sign-Ups")</h5>
                @if (!string.IsNullOrWhiteSpace(settings.Subtitle))
                {
                    <p class="text-muted mb-2">@settings.Subtitle</p>
                }

                <div class="small text-muted mb-3">
                    <div>Status: <strong>@GetSignupStatusText()</strong></div>
                    <div>Window: @FormatDate(settings.SignupStart) - @FormatDate(settings.SignupEnd)</div>
                    @if (settings.ShowCountdown && IsSignupOpenNow())
                    {
                        <div>Countdown is enabled.</div>
                    }
                </div>

                <div class="row g-2">
                    <div class="col-md-6">
                        <input class="form-control form-control-sm" value="Performer name(s)" disabled />
                    </div>
                    <div class="col-md-6">
                        <input class="form-control form-control-sm" value="Act title" disabled />
                    </div>
                    <div class="col-md-6">
                        <input class="form-control form-control-sm" value="Grade" disabled />
                    </div>
                    <div class="col-md-6">
                        <input class="form-control form-control-sm" value="Teacher" disabled />
                    </div>
                    <div class="col-md-6">
                        <input class="form-control form-control-sm" value="Contact email" disabled />
                    </div>
                    <div class="col-md-6">
                        <input class="form-control form-control-sm" value="Contact phone" disabled />
                    </div>
                    <div class="col-12">
                        <textarea class="form-control form-control-sm" rows="2" disabled>Act description</textarea>
                    </div>
                    <div class="col-12">
                        <textarea class="form-control form-control-sm" rows="2" disabled>Special requirements</textarea>
                    </div>
                    <div class="col-12">
                        <input class="form-control form-control-sm" value="Media upload link or path (optional)" disabled />
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(settings.ConfirmationMessage))
                {
                    <div class="alert alert-success mt-3 mb-0 py-2">
                        <strong>Confirmation Message:</strong> @settings.ConfirmationMessage
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int EventId { get; set; }

    private TalentShowSignupSettingsDTO settings = new();
    private bool isLoading = true;
    private bool isSaving;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            settings = await Http.GetFromJsonAsync<TalentShowSignupSettingsDTO>($"/api/talentshow/{EventId}/signups/configure")
                ?? new TalentShowSignupSettingsDTO();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading sign-up settings: {ex.Message}";
            settings = new TalentShowSignupSettingsDTO();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        try
        {
            var response = await Http.PutAsJsonAsync($"/api/talentshow/{EventId}/signups/configure", settings);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                errorMessage = string.IsNullOrWhiteSpace(body) ? "Failed to save sign-up settings." : body;
                return;
            }

            successMessage = "Sign-up settings saved.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving sign-up settings: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private bool IsSignupOpenNow()
    {
        var now = DateTime.Now;
        var startOk = !settings.SignupStart.HasValue || now >= settings.SignupStart.Value;
        var endOk = !settings.SignupEnd.HasValue || now <= settings.SignupEnd.Value;
        return settings.IsPublished && startOk && endOk;
    }

    private string GetSignupStatusText()
    {
        if (!settings.IsPublished)
        {
            return "Draft (not published)";
        }

        return IsSignupOpenNow() ? "Open" : "Closed";
    }

    private static string FormatDate(DateTime? value)
    {
        return value?.ToString("MMM d, yyyy") ?? "Not set";
    }
}
