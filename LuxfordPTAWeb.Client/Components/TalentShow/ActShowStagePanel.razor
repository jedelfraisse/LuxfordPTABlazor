@using LuxfordPTAWeb.Shared.DTOs

<div>
    <h6 class="text-danger mb-3"><i class="bi bi-star"></i> Act Show Stage</h6>
    
    <p class="text-muted">Live act performance display and voting management.</p>
    
    <div class="row g-3">
        <div class="col-12">
            <label class="form-label">Act Show Overview</label>
            <div class="alert alert-info">
                <strong>Current Act Display:</strong> Shows performer name, act title, and duration timer<br />
                <strong>Voting:</strong> Open/close voting from the director control panel (Main Rehearsal Control)<br />
                <strong>Main Board Display:</strong> Shows current act title, performer, and intro line
            </div>
        </div>

        <div class="col-12">
            <label class="form-label">Current Act Notes</label>
            <textarea class="form-control" @bind="actNotes" rows="5" placeholder="Add timing notes, technical issues, or performance notes..."></textarea>
        </div>

        <div class="col-md-6">
            <label class="form-label">Voting Status</label>
            <div class="input-group">
                <span class="input-group-text">Voting</span>
                <button class="btn btn-outline-success" @onclick="() => votingOpen = true" disabled="@votingOpen">Open</button>
                <button class="btn btn-outline-danger" @onclick="() => votingOpen = false" disabled="@(!votingOpen)">Close</button>
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label">Show Timing</label>
            <input type="text" class="form-control" value="@GetShowDuration()" disabled />
        </div>
    </div>

    <div class="mt-3">
        <button class="btn btn-primary" @onclick="SaveActShowAsync" disabled="@isSaving">
            <i class="bi bi-check-circle"></i> Save Act Notes
        </button>
        @if (!string.IsNullOrWhiteSpace(saveMessage))
        {
            <span class="ms-2 text-success">@saveMessage</span>
        }
    </div>
</div>

@code {
    [Parameter] public int EventId { get; set; }

    private string actNotes = string.Empty;
    private bool votingOpen;
    private bool isSaving;
    private string saveMessage = string.Empty;

    private string GetShowDuration()
    {
        var elapsed = DateTime.Now.TimeOfDay;
        return $"{(int)elapsed.TotalHours:00}:{elapsed.Minutes:00}:{elapsed.Seconds:00}";
    }

    private async Task SaveActShowAsync()
    {
        isSaving = true;
        saveMessage = string.Empty;
        try
        {
            saveMessage = "Act Show notes saved successfully!";
            await Task.Delay(1500);
            saveMessage = string.Empty;
        }
        catch (Exception ex)
        {
            saveMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
