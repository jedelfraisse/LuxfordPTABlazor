@using LuxfordPTAWeb.Shared.DTOs
@using LuxfordPTAWeb.Shared.Models
@inject HttpClient Http

<div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="text-primary mb-0"><i class="bi bi-play-circle"></i> Show Live - Segment Timeline</h6>
        <a class="btn btn-outline-secondary btn-sm" href="@($"/admin/eventcontrols/talent-show-director/{EventId}/tools/show/configure")">Go to Configure</a>
    </div>
    <p class="text-muted">Control the live show in real-time. Advance segments, manage voting, trigger cues, and control media.</p>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (isLoading)
    {
        <div class="alert alert-info"><em>Loading show runtime...</em></div>
    }
    else if (runtimeState == null)
    {
        <div class="alert alert-warning">No show runtime found.</div>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body p-2">
                        <small class="text-muted">Current Segment</small>
                        @{
                            var currentSeg = runtimeState.Segments.FirstOrDefault(s => s.SegmentId == runtimeState.CurrentSegmentId);
                        }
                        <div class="fw-bold">@(currentSeg?.Title ?? "Not started")</div>
                        <small class="text-muted">@(currentSeg?.SegmentType ?? "-")</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body p-2">
                        <small class="text-muted">Show Mode</small>
                        <div class="fw-bold">@(runtimeState.IsLiveMode ? "LIVE" : "READY")</div>
                        @if (runtimeState.ShowStartTime.HasValue)
                        {
                            <small class="text-muted">Started: @runtimeState.ShowStartTime.Value.ToLocalTime().ToString("t")</small>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body p-2">
                        <small class="text-muted">Voting Status</small>
                        <div>
                            <span class="badge @(runtimeState.JudgesVotingOpen ? "bg-success" : "bg-light text-dark")">
                                Judges @(runtimeState.JudgesVotingOpen ? "ON" : "OFF")
                            </span>
                            <span class="badge @(runtimeState.AudienceVotingOpen ? "bg-success" : "bg-light text-dark")">
                                Audience @(runtimeState.AudienceVotingOpen ? "ON" : "OFF")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Current Segment Live View -->
        @if (currentSeg != null)
        {
            <div class="card mb-3 border-success">
                <div class="card-header bg-success text-white">
                    <h6 class="mb-0">🔴 LIVE: @currentSeg.Title</h6>
                </div>
                <div class="card-body">
                    <div class="row g-2 mb-2">
                        <div class="col-md-3">
                            <strong>Type:</strong> @currentSeg.SegmentType
                        </div>
                        <div class="col-md-3">
                            <strong>Duration:</strong> @currentSeg.ExpectedDurationSeconds s
                        </div>
                        <div class="col-md-3">
                            <strong>Status:</strong> <span class="badge bg-info">@currentSeg.Status</span>
                        </div>
                        <div class="col-md-3">
                            <strong>Hidden:</strong> @(currentSeg.IsHidden ? "Yes" : "No")
                        </div>
                    </div>

                    @if (currentSeg.DisplayInstructions != null)
                    {
                        <div class="row g-2 mb-3">
                            @if (!string.IsNullOrWhiteSpace(currentSeg.DisplayInstructions.HostTeleprompter))
                            {
                                <div class="col-md-6">
                                    <div class="border-start ps-2 mb-2">
                                        <strong>📝 Host Teleprompter:</strong>
                                        <div class="small text-muted">@currentSeg.DisplayInstructions.HostTeleprompter</div>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(currentSeg.DisplayInstructions.Backstage))
                            {
                                <div class="col-md-6">
                                    <div class="border-start ps-2 mb-2">
                                        <strong>🎭 Backstage:</strong>
                                        <div class="small text-muted">@currentSeg.DisplayInstructions.Backstage</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 mb-2">
                        @if (!string.IsNullOrWhiteSpace(currentSeg.MediaFile))
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="@(() => TriggerAction("Play media: " + currentSeg.MediaFile))">
                                <i class="bi bi-play"></i> Play Media
                            </button>
                            <button class="btn btn-sm btn-outline-warning" @onclick="@(() => TriggerAction("Pause media"))">
                                <i class="bi bi-pause"></i> Pause
                            </button>
                        }
                        <button class="btn btn-sm btn-outline-info" @onclick="@(() => OpenVotingControlDialog(currentSeg.ActId ?? 0))">
                            <i class="bi bi-card-checklist"></i> Manage Voting
                        </button>
                    </div>
                </div>
            </div>
        }

        <!-- Segment Timeline -->
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="mb-0">Segment Timeline (@runtimeState.Segments.Count)</h6>
            </div>
            <div class="card-body">
                @if (!runtimeState.Segments.Any())
                {
                    <div class="alert alert-light border">No segments in timeline.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">Order</th>
                                    <th>Type</th>
                                    <th>Title</th>
                                    <th>Duration</th>
                                    <th>Status</th>
                                    <th style="width: 250px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var segment in runtimeState.Segments)
                                {
                                    var isCurrentLive = segment.SegmentId == runtimeState.CurrentSegmentId && segment.Status == TalentShowSegmentStatus.Live;
                                    <tr class="@(isCurrentLive ? "table-success" : "")">
                                        <td>@segment.OrderIndex</td>
                                        <td><span class="badge bg-secondary">@segment.SegmentType</span></td>
                                        <td>
                                            <div>@segment.Title</div>
                                            @if (segment.IsHidden)
                                            {
                                                <small class="text-warning">🔒 Hidden</small>
                                            }
                                        </td>
                                        <td>@segment.ExpectedDurationSeconds s</td>
                                        <td>
                                            <span class="badge @(GetStatusBadgeClass(segment.Status))">@segment.Status</span>
                                        </td>
                                        <td>
                                            @if (segment.SegmentId != runtimeState.CurrentSegmentId)
                                            {
                                                <button class="btn btn-sm btn-success" @onclick="@(() => AdvanceToSegmentAsync(segment.SegmentId))" title="Start this segment">
                                                    <i class="bi bi-arrow-right"></i> Start
                                                </button>
                                            }
                                            @if (segment.Status != TalentShowSegmentStatus.Skipped && segment.Status != TalentShowSegmentStatus.Completed)
                                            {
                                                <button class="btn btn-sm btn-warning" @onclick="@(() => SkipSegmentAsync(segment.SegmentId))" title="Skip to bottom">
                                                    <i class="bi bi-skip-end"></i> Skip
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => JumpToSegmentAsync(segment.SegmentId))" title="Jump to this segment">
                                                <i class="bi bi-fast-forward"></i> Jump
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Insert New Segment Section -->
        <div class="card mt-3">
            <div class="card-header bg-light">
                <h6 class="mb-0">Insert New Segment</h6>
            </div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-md-3">
                        <select class="form-select form-select-sm" @bind="newSegmentType">
                            <option value="">Select type...</option>
                            @foreach (var type in TalentShowSegmentType.All)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <input class="form-control form-control-sm" placeholder="Title" @bind="newSegmentTitle" />
                    </div>
                    <div class="col-md-2">
                        <input class="form-control form-control-sm" placeholder="Duration (s)" type="number" @bind="newSegmentDuration" />
                    </div>
                    <div class="col-md-2">
                        <input type="number" class="form-control form-control-sm" placeholder="Insert at..." @bind="insertAtIndex" min="0" />
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-outline-primary btn-sm w-100" @onclick="InsertSegmentAsync" disabled="@(string.IsNullOrWhiteSpace(newSegmentType))">
                            Insert
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Voting Control Dialog -->
        @if (showVotingDialog && currentActId > 0)
        {
            <div class="card mt-3 border-info">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">Voting Control - Act @currentActId</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="@(() => showVotingDialog = false)"></button>
                </div>
                <div class="card-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <button class="btn btn-outline-success w-100" @onclick="@(() => ControlVotingAsync(true, false))">
                                <i class="bi bi-unlock"></i> Open Judges Voting
                            </button>
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-outline-success w-100" @onclick="@(() => ControlVotingAsync(false, true))">
                                <i class="bi bi-unlock"></i> Open Audience Voting
                            </button>
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-outline-danger w-100" @onclick="@(() => ControlVotingAsync(false, false, true))">
                                <i class="bi bi-lock"></i> Close All Voting
                            </button>
                        </div>
                    </div>
                    <div class="alert alert-light border">
                        <small>Judges voting: <strong>@(runtimeState.JudgesVotingOpen ? "OPEN" : "CLOSED")</strong><br/>
                        Audience voting: <strong>@(runtimeState.AudienceVotingOpen ? "OPEN" : "CLOSED")</strong></small>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public int EventId { get; set; }

    private TalentShowRuntimeStateDTO? runtimeState;
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private bool showVotingDialog;
    private int currentActId;

    private string newSegmentType = string.Empty;
    private string newSegmentTitle = string.Empty;
    private int newSegmentDuration = 300;
    private int insertAtIndex = 0;

    protected override async Task OnParametersSetAsync()
    {
        await LoadRuntimeStateAsync();
    }

    private async Task LoadRuntimeStateAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            runtimeState = await Http.GetFromJsonAsync<TalentShowRuntimeStateDTO>($"/api/talentshow/{EventId}/show/runtime")
                ?? new TalentShowRuntimeStateDTO();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading runtime state: {ex.Message}";
            runtimeState = new TalentShowRuntimeStateDTO();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AdvanceToSegmentAsync(int segmentId)
    {
        if (runtimeState == null) return;

        errorMessage = string.Empty;
        try
        {
            var dto = new TalentShowSegmentAdvanceDTO { SegmentId = segmentId };
            var response = await Http.PostAsJsonAsync($"/api/talentshow/{EventId}/show/advance", dto);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Failed to advance to segment.";
                return;
            }

            await LoadRuntimeStateAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error advancing segment: {ex.Message}";
        }
    }

    private async Task JumpToSegmentAsync(int segmentId)
    {
        if (runtimeState == null) return;

        errorMessage = string.Empty;
        try
        {
            var dto = new TalentShowJumpSegmentDTO { SegmentId = segmentId };
            var response = await Http.PostAsJsonAsync($"/api/talentshow/{EventId}/show/jump", dto);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Failed to jump to segment.";
                return;
            }

            await LoadRuntimeStateAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error jumping to segment: {ex.Message}";
        }
    }

    private async Task SkipSegmentAsync(int segmentId)
    {
        if (runtimeState == null) return;

        errorMessage = string.Empty;
        try
        {
            var dto = new TalentShowSegmentSkipDTO { SegmentId = segmentId };
            var response = await Http.PostAsJsonAsync($"/api/talentshow/{EventId}/show/skip", dto);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Failed to skip segment.";
                return;
            }

            await LoadRuntimeStateAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error skipping segment: {ex.Message}";
        }
    }

    private async Task InsertSegmentAsync()
    {
        if (string.IsNullOrWhiteSpace(newSegmentType))
        {
            errorMessage = "Please select a segment type.";
            return;
        }

        errorMessage = string.Empty;
        try
        {
            var dto = new TalentShowSegmentInsertDTO
            {
                SegmentType = newSegmentType,
                Title = newSegmentTitle,
                InsertAtIndex = insertAtIndex,
                DurationSeconds = newSegmentDuration
            };

            var response = await Http.PostAsJsonAsync($"/api/talentshow/{EventId}/show/insert", dto);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Failed to insert segment.";
                return;
            }

            newSegmentType = string.Empty;
            newSegmentTitle = string.Empty;
            newSegmentDuration = 300;
            insertAtIndex = 0;

            await LoadRuntimeStateAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error inserting segment: {ex.Message}";
        }
    }

    private void OpenVotingControlDialog(int actId)
    {
        currentActId = actId;
        showVotingDialog = true;
    }

    private async Task ControlVotingAsync(bool openJudges, bool openAudience, bool closeAll = false)
    {
        if (runtimeState == null) return;

        errorMessage = string.Empty;
        try
        {
            var dto = new TalentShowVotingControlDTO
            {
                OpenJudgesVoting = openJudges,
                OpenAudienceVoting = openAudience,
                CloseVoting = closeAll
            };

            var response = await Http.PostAsJsonAsync($"/api/talentshow/{EventId}/show/voting/control", dto);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Failed to control voting.";
                return;
            }

            await LoadRuntimeStateAsync();
            showVotingDialog = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error controlling voting: {ex.Message}";
        }
    }

    private void TriggerAction(string action)
    {
        // Placeholder for future media/cue control implementation
        errorMessage = $"Action triggered: {action}";
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            TalentShowSegmentStatus.Live => "bg-success",
            TalentShowSegmentStatus.Completed => "bg-secondary",
            TalentShowSegmentStatus.Skipped => "bg-warning",
            _ => "bg-light text-dark"
        };
    }
}
