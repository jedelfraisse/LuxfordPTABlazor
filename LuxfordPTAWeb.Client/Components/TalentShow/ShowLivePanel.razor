@using LuxfordPTAWeb.Shared.DTOs
@inject HttpClient Http

<div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="text-primary mb-0"><i class="bi bi-broadcast"></i> Show Live Workspace</h6>
        <a class="btn btn-outline-secondary btn-sm" href="@($"/admin/eventcontrols/talent-show-director/{EventId}/tools/show/configure")">Go to Config</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (isLoading)
    {
        <div class="alert alert-info"><em>Loading live state...</em></div>
    }
    else if (runtimeState.ConfigStatus != TalentShowConfigStatus.Ready)
    {
        <div class="alert alert-warning">
            Live workspace is locked. Set Config Status to <strong>Ready</strong> in the Show Config workspace.
        </div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-header fw-semibold">Live Status</div>
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Current Status</label>
                        <input class="form-control" value="@runtimeState.LiveStatus" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Target Status</label>
                        <select class="form-select" @bind="targetLiveStatus">
                            @foreach (var status in TalentShowLiveStatus.All)
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Countdown (sec)</label>
                        <input type="number" min="0" class="form-control" @bind="countdownSeconds" />
                    </div>
                    <div class="col-md-2 d-grid">
                        <button class="btn btn-primary" @onclick="ChangeLiveStatusAsync">Apply</button>
                    </div>
                </div>
                @if (runtimeState.LiveCountdownTargetUtc.HasValue)
                {
                    <div class="mt-2 text-muted">
                        Countdown running. Target: @runtimeState.LiveCountdownTargetUtc.Value.ToLocalTime().ToString("T")
                    </div>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">Segment Flow</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>#</th><th>Type</th><th>Segment</th><th>Status</th><th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var segment in runtimeState.Segments.OrderBy(s => s.OrderIndex))
                            {
                                var isCurrent = runtimeState.CurrentSegmentId == segment.SegmentId;
                                <tr class="@(isCurrent ? "table-primary" : string.Empty)">
                                    <td>@segment.OrderIndex</td>
                                    <td>@segment.SegmentType</td>
                                    <td>@segment.Title</td>
                                    <td>@segment.Status</td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <button class="btn btn-outline-success btn-sm" @onclick="@(() => StartSegmentAsync(segment.SegmentId))">Start</button>
                                            <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => EndSegmentAsync(segment.SegmentId))">End</button>
                                            <button class="btn btn-outline-warning btn-sm" @onclick="@(() => SkipSegmentAsync(segment.SegmentId))">Skip</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer">
                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm" @onclick="NextSegmentAsync">Next Segment</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ReloadAsync">Refresh</button>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">Performer Flow (StandBy → OnDeck → Performing → Completed)</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Performer</th><th>Act</th><th>Status</th><th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var performer in runtimeState.PerformerQueue)
                            {
                                <tr>
                                    <td>@performer.PerformerName</td>
                                    <td>@performer.ActTitle</td>
                                    <td>@performer.Status</td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => UpdatePerformerStatusAsync(performer, "StandBy"))">StandBy</button>
                                            <button class="btn btn-outline-primary btn-sm" @onclick="@(() => UpdatePerformerStatusAsync(performer, "OnDeck"))">OnDeck</button>
                                            <button class="btn btn-outline-success btn-sm" @onclick="@(() => UpdatePerformerStatusAsync(performer, "Performing"))">Performing</button>
                                            <button class="btn btn-outline-dark btn-sm" @onclick="@(() => UpdatePerformerStatusAsync(performer, "Completed"))">Completed</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int EventId { get; set; }

    private TalentShowRuntimeStateDTO runtimeState = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private string targetLiveStatus = TalentShowLiveStatus.PreShow;
    private int countdownSeconds = 10;

    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        try
        {
            runtimeState = await Http.GetFromJsonAsync<TalentShowRuntimeStateDTO>($"/api/talentshow/{EventId}/show/runtime")
                ?? new TalentShowRuntimeStateDTO();
            targetLiveStatus = runtimeState.LiveStatus;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading live state: {ex.Message}";
            runtimeState = new TalentShowRuntimeStateDTO();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangeLiveStatusAsync()
    {
        var response = await Http.PostAsJsonAsync($"/api/talentshow/{EventId}/show/live/status", new TalentShowLiveStatusTransitionDTO
        {
            TargetStatus = targetLiveStatus,
            CountdownSeconds = countdownSeconds
        });
        if (!response.IsSuccessStatusCode)
        {
            errorMessage = "Failed to change live status.";
            return;
        }

        successMessage = $"Live Status updated to {targetLiveStatus}.";
        await ReloadAsync();
    }

    private async Task StartSegmentAsync(int segmentId)
    {
        await ExecuteSegmentActionAsync("start", segmentId);
    }

    private async Task EndSegmentAsync(int segmentId)
    {
        await ExecuteSegmentActionAsync("end", segmentId);
    }

    private async Task SkipSegmentAsync(int segmentId)
    {
        await ExecuteSegmentActionAsync("skip", segmentId);
    }

    private async Task NextSegmentAsync()
    {
        var response = await Http.PostAsync($"/api/talentshow/{EventId}/show/live/segment/next", null);
        if (!response.IsSuccessStatusCode)
        {
            errorMessage = "Failed to move to next segment.";
            return;
        }

        await ReloadAsync();
    }

    private async Task ExecuteSegmentActionAsync(string action, int segmentId)
    {
        var response = await Http.PostAsJsonAsync($"/api/talentshow/{EventId}/show/live/segment/{action}", new TalentShowSegmentActionDTO
        {
            SegmentId = segmentId
        });
        if (!response.IsSuccessStatusCode)
        {
            errorMessage = $"Failed to {action} segment.";
            return;
        }

        await ReloadAsync();
    }

    private async Task UpdatePerformerStatusAsync(TalentShowPerformerQueueEntryDTO performer, string status)
    {
        var response = await Http.PostAsJsonAsync($"/api/talentshow/{EventId}/show/live/performer/update", new TalentShowPerformerStatusUpdateDTO
        {
            ActId = performer.ActId,
            PerformerName = performer.PerformerName,
            ActTitle = performer.ActTitle,
            Status = status
        });
        if (!response.IsSuccessStatusCode)
        {
            errorMessage = "Failed to update performer status.";
            return;
        }

        await ReloadAsync();
    }
}
