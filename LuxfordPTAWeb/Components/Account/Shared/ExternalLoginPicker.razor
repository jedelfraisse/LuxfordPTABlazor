@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using LuxfordPTAWeb.Data
@using LuxfordPTAWeb.Shared.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject NavigationManager NavigationManager

@if (externalLogins.Length == 0)
{
    <div class="alert alert-info">
        <h6>No external authentication services configured</h6>
        <p class="mb-0">
            Google OAuth is configured but may be disabled. Check your configuration.
        </p>
    </div>
}
else
{
    <section>
        <h3>Use another service to log in.</h3>
        <hr />
        <EditForm Model="Input" OnValidSubmit="OnValidSubmitAsync" FormName="external-login" method="post">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            @foreach (var provider in externalLogins)
            {
                <button type="submit" class="btn btn-outline-danger w-100 mb-2" name="Input.Provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                    @if (provider.Name == "Google")
                    {
                        <i class="fab fa-google me-2"></i>
                    }
                    Sign in with @provider.DisplayName
                </button>
            }
        </EditForm>
    </section>
}

@code {
    private AuthenticationScheme[] externalLogins = [];

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // PTA Tech Note: This loads available external authentication providers (Google, Microsoft, etc.)
        externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToArray();
    }

    public async Task OnValidSubmitAsync()
    {
        // Store the location we'll return to after authentication
        var baseUri = NavigationManager.BaseUri.TrimEnd('/');
        var redirectUrl = $"{baseUri}/Account/ExternalLogin?handler=Callback&returnUrl={Uri.EscapeDataString(ReturnUrl ?? "/")}";
        var properties = SignInManager.ConfigureExternalAuthenticationProperties(Input.Provider, redirectUrl);
        await HttpContext.ChallengeAsync(Input.Provider, properties);
    }

    private sealed class InputModel
    {
        public string Provider { get; set; } = "";
    }
}
