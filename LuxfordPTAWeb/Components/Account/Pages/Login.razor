@page "/Account/Login"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using LuxfordPTAWeb.Data
@using LuxfordPTAWeb.Shared.Models
@using LuxfordPTAWeb.Services

@inject IPasswordlessLoginService PasswordlessLoginService
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject IConfiguration Configuration

<PageTitle>Log in</PageTitle>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <section>
            <StatusMessage Message="@errorMessage" />
            <EditForm Model="Input" FormName="loginForm" method="post" OnValidSubmit="RequestCode">
                <DataAnnotationsValidator />
                <h2>Log in to the PTA Portal</h2>
                <p class="text-muted mb-2">
                    Enter your email and we'll send you a one-time login code — no password needed.
                    This website is still in development; some features are limited to board members and admins.
                </p>
                <hr />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label for="Input.Email" class="form-label">Email</label>
                    <ValidationMessage For="() => Input.Email" class="text-danger" />
                </div>
                <div>
                    <button type="submit" class="w-100 btn btn-lg btn-primary">Send login code</button>
                </div>
            </EditForm>
        </section>

        <div class="alert alert-info mt-4">
            <h6>New here?</h6>
            <p class="mb-0">Just enter your email above — an account is created automatically. Board members and volunteers get full access once they're added to the member list.</p>
        </div>
    </div>
</div>

@code {
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Input.Email) && !string.IsNullOrEmpty(Email))
        {
            Input.Email = Email;
        }

        // Only clear external cookies if we haven't started streaming the response yet
        if (HttpMethods.IsGet(HttpContext.Request.Method) && !HttpContext.Response.HasStarted)
        {
            try
            {
                // Clear the existing external cookie to ensure a clean login process
                await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
            }
            catch (InvalidOperationException)
            {
                // If response has already started, we can't modify cookies
                // This is fine - the cookie will be cleared on next request
                Logger.LogWarning("Could not clear external authentication cookie - response already started");
            }
        }
    }

    private async Task RequestCode()
    {
        var result = await PasswordlessLoginService.RequestCodeAsync(Input.Email);

        if (result.Status == RequestCodeStatus.Error)
        {
            Logger.LogError("Failed to send login code to {Email}", Input.Email);
            errorMessage = "Error: We couldn't send a login code right now. Please try again in a moment.";

            // Debug details are shown when Login:ShowDebugErrors is on (leaks server-side details
            // like the SMTP error to anyone on the login page — dev/staging only), OR when this
            // specific diagnostic account is being used, so we can troubleshoot in production
            // without exposing it to every visitor. Remove the email check once done troubleshooting.
            var showDebug = Configuration.GetValue<bool>("Login:ShowDebugErrors")
                || Input.Email.Equals("jonathan@delfraisse.com", StringComparison.OrdinalIgnoreCase);

            if (showDebug && !string.IsNullOrWhiteSpace(result.DebugMessage))
            {
                errorMessage += $" [Debug: {result.DebugMessage}]";
            }

            return;
        }

        // Sent, or TooSoon (a still-valid code was already emailed) — either way, go enter it.
        RedirectManager.RedirectTo("Account/LoginVerify", new()
        {
            ["email"] = Input.Email,
            ["returnUrl"] = ReturnUrl
        });
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";
    }
}
